       ein nativer Absturz oder eine Speicherspitze Lumora nicht beendet. Steht wie Lumora.AppConnect über den Services:
       Domain ← Data ← Services ← Imaging ← Wpf. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumora.Services\Lumora.Services.csproj" />
    <ProjectReference Include="..\Lumora.Imaging.Protocol\Lumora.Imaging.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lumora.Imaging.Tests" />
  </ItemGroup>

</Project>
