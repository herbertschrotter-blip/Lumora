<UserControl x:Class="Lumora.Settings.Sections.SettingsAiEditSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ai="clr-namespace:Lumora.AiEdit"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance ai:AiEditSettingsViewModel}"
             d:DesignWidth="1000">
    <!-- Einstellungen › KI-Bearbeitung (ADR-0076, Mockup 23) — der Reiter existiert nur in der geöffneten versteckten
         Sitzung. DataContext = AiEditSettingsViewModel. Stufe 1: Laufzeit, Leerlauf, Platz, Modelle. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Zustandspunkt: grün läuft, gelb startet/beendet, rot Fehler, grau aus -->
            <Style x:Key="StateDot" TargetType="Ellipse">
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StateKind}" Value="Ok">
                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StateKind}" Value="Busy">
                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StateKind}" Value="Error">
                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- Zeile: links Titel + Erklärung, rechts Wert bzw. Bedienelement (Mockup 23 „row“) -->
            <Style x:Key="Row" TargetType="Grid">
                <Setter Property="Margin" Value="0,10,0,0" />
            </Style>
            <Style x:Key="RowTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource SectionPanel}" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource SectionTitle}" Text="KI-Bearbeitung im Container" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Programm, Modelle, Zwischenstände und Caches liegen nur im geöffneten Container (Ordner .lumora-ki). Lumora startet die Bearbeitung nur auf diesem PC (127.0.0.1) und beendet sie beim Zusperren, beim Verlassen der versteckten Bibliothek, beim Beenden von Lumora und nach Leerlauf. Ist der Container zu, gibt es sie nicht." />

                    <!-- Laufzeit -->
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Laufzeit" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding InstallText}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding DeviceText}"
                                       Visibility="{Binding DeviceText, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                                    AutomationProperties.Name="{Binding StateText}">
                            <Ellipse Style="{StaticResource StateDot}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding StateText}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding Message}"
                               Visibility="{Binding Message, Converter={StaticResource NullToVis}}" />

                    <!-- Probelauf / Beenden -->
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Probelauf" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Startet ComfyUI und prüft Version und Grafikkarte. „Beenden“ bricht einen laufenden Auftrag ab und leert die Arbeitsordner." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <ui:Button Content="Starten" Icon="{ui:SymbolIcon Play24}" Margin="0,0,8,0"
                                       Command="{Binding StartCommand}" AutomationProperties.Name="ComfyUI starten" />
                            <ui:Button Content="Beenden" Icon="{ui:SymbolIcon Stop24}"
                                       Command="{Binding StopCommand}" AutomationProperties.Name="ComfyUI beenden" />
                        </StackPanel>
                    </Grid>

                    <!-- Leerlauf -->
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Nach Leerlauf beenden" />
                            <TextBlock Style="{StaticResource Hint}" Text="gibt Grafikkarte und Speicher wieder frei (0 = erst beim Zusperren)" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <ui:NumberBox Value="{Binding IdleMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Minimum="0" Maximum="{Binding MaxIdleMinutes, Mode=OneTime}"
                                          SmallChange="1" LargeChange="5" MaxDecimalPlaces="0"
                                          SpinButtonPlacementMode="Inline" Width="140"
                                          AutomationProperties.Name="Leerlauf in Minuten" />
                            <TextBlock Style="{StaticResource Label}" Text="Minuten" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Platz -->
                    <Grid Style="{StaticResource Row}">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Platz im Container" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding SpaceText}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}" Visibility="{Binding HasModels, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Modelle und Erweiterungen (im Container)" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="Jede Datei wird einzeln erst nach Bestätigung geladen — direkt in den Container. Keine Updates, keine weiteren Erweiterungen, keine Online-Knoten." />
                    <ItemsControl ItemsSource="{Binding Models}" AutomationProperties.Name="Modelle und Erweiterungen">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ai:AiEditModelRow}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ValueText}" FontWeight="SemiBold" Text="{Binding Purpose}" ToolTip="{Binding Purpose}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Name}" ToolTip="{Binding Name}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding SizeText}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource ValueText}" Text="{Binding License}" ToolTip="{Binding License}" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource ValueText}" Text="{Binding StateText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Was noch kommt" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Diese Stufe richtet nur die Laufzeit ein. Vorlagen (Entfernen, Erweitern, Verbessern, später Hintergrund und Outfit), die Grenzen der Bearbeitung mit Prüfung jedes Ergebnisses und das ComfyUI-Fenster folgen in den nächsten Stufen." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
