<UserControl x:Class="Lumora.Settings.Sections.SettingsSecurityCheckSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:check="clr-namespace:Lumora.Shell.HiddenLibraries.SecurityCheck"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance check:SecurityCheckViewModel}"
             d:DesignWidth="1000">
    <!-- Einstellungen › Sicherheits-Check (ADR-0064, Mockup 14) — der Reiter existiert nur in der geöffneten versteckten
         Sitzung. DataContext = SecurityCheckViewModel. Lumora ändert keine Windows-Einstellung. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Etikett neben dem Titel: rot „wichtigster Punkt“, gelb „empfohlen …“, grau sonst -->
            <Style x:Key="CheckTag" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="7,1" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TagKind}" Value="Critical">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TagKind}" Value="Recommended">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CheckTagText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TagKind}" Value="Critical">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TagKind}" Value="Recommended">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- Status-Kreis: grün erfüllt, rot wichtigster Punkt offen, gelb empfohlen offen, grau Zusatz/unbekannt -->
            <Style x:Key="CheckDot" TargetType="Border">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Margin" Value="0,1,0,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Background" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Dot}" Value="Ok">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Dot}" Value="Critical">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Dot}" Value="Warning">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource SectionPanel}">
            <!-- Wertung: Ring „x/y“, Frage, Erklärung, Erneut prüfen, Erfüllte ausblenden -->
            <Border Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="64" Height="64" VerticalAlignment="Top" Margin="0,0,16,0"
                          AutomationProperties.Name="{Binding SummaryText}">
                        <Ellipse Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Opacity="0.35" StrokeThickness="7" Margin="3.5" />
                        <ui:Arc x:Name="ScoreArc" StartAngle="0" EndAngle="{Binding ScoreAngle}" StrokeThickness="7" Margin="3.5"
                                Visibility="{Binding HasScore, Converter={StaticResource BoolToVisibility}}">
                            <ui:Arc.Style>
                                <Style TargetType="ui:Arc">
                                    <Setter Property="Stroke" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAllFulfilled}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Arc.Style>
                        </ui:Arc>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"
                                   Text="{Binding ScoreText}" />
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="LockClosed24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <ui:TextBlock FontTypography="BodyStrong" TextWrapping="Wrap"
                                          Text="Wie gut ist diese versteckte Bibliothek gegen Spuren geschützt?" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Lead}" />
                        <WrapPanel Margin="0,10,0,0">
                            <ui:Button Margin="0,0,8,0" Content="Erneut prüfen" Command="{Binding RefreshCommand}"
                                       Icon="{ui:SymbolIcon ArrowSync24}" AutomationProperties.Name="Erneut prüfen" />
                            <ui:ToggleSwitch Margin="8,0,0,0" Content="Erfüllte ausblenden" IsChecked="{Binding HideFulfilled, Mode=TwoWay}"
                                             AutomationProperties.Name="Erfüllte ausblenden" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding Message}"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding Message, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Gefahren-Stufe -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="Shield24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ui:TextBlock FontTypography="BodyStrong" Text="Wovor möchten Sie sich schützen?" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Levels}" AutomationProperties.Name="Gefahren-Stufe">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type check:ThreatLevelOption}">
                                <RadioButton GroupName="SecurityCheckLevel" Margin="0,0,8,0" VerticalContentAlignment="Top"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             AutomationProperties.Name="{Binding Title}">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Description}" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding LevelNote}" />
                </StackPanel>
            </Border>

            <!-- Punkte -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.Name="Punkte des Sicherheits-Checks">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type check:SecurityCheckRowViewModel}">
                                <Grid Margin="0,0,0,12" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.Name="{Binding Title}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource CheckDot}" HorizontalAlignment="Left">
                                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="12" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource CheckTag}">
                                                <TextBlock Style="{StaticResource CheckTagText}" Text="{Binding Tag}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{Binding Detail}" />
                                        <Border Margin="0,6,0,0" Padding="10,8" CornerRadius="6"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                Visibility="{Binding IsHowtoOpen, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Hint}" Text="{Binding Howto}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <ui:Button Content="{Binding OpenLabel}" Command="{Binding OpenCommand}"
                                                   IsEnabled="{Binding CanOpen}"
                                                   Visibility="{Binding ShowOpenButton, Converter={StaticResource BoolToVisibility}}"
                                                   AutomationProperties.Name="{Binding OpenLabel}" />
                                        <ui:Button Margin="4,0,0,0" Padding="8,6" Appearance="Transparent" ToolTip="Anleitung"
                                                   Command="{Binding ToggleHowtoCommand}" Icon="{ui:SymbolIcon Info24}"
                                                   Visibility="{Binding HasHowto, Converter={StaticResource BoolToVisibility}}"
                                                   AutomationProperties.Name="Anleitung" />
                                        <ui:ToggleSwitch IsChecked="{Binding DataContext.ExitAfterLock, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         Visibility="{Binding IsToggle, Converter={StaticResource BoolToVisibility}}"
                                                         AutomationProperties.Name="Lumora nach dem Zusperren ganz beenden" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Info-Punkt: nicht abschaltbar -->
                    <Grid AutomationProperties.Name="{Binding InfoTitle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="22" Height="22" CornerRadius="11" Margin="0,1,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                Background="{DynamicResource TextFillColorTertiaryBrush}">
                            <ui:SymbolIcon Symbol="Info24" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold" Text="{Binding InfoTitle}" VerticalAlignment="Center" />
                                <Border CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="nur zur Info" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{Binding InfoText}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
