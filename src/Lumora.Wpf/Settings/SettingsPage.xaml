<UserControl x:Class="Lumora.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shell="clr-namespace:Lumora.Shell"
             xmlns:local="clr-namespace:Lumora.Settings"
             xmlns:sections="clr-namespace:Lumora.Settings.Sections"
             xmlns:info="clr-namespace:Lumora.Settings.Info"
             xmlns:stories="clr-namespace:Lumora.Stories"
             xmlns:tracks="clr-namespace:Lumora.Places.TrackSettings"
             xmlns:assistant="clr-namespace:Lumora.Stories.Assistant"
             xmlns:models="clr-namespace:Lumora.Settings.ModelPackages"
             xmlns:enhance="clr-namespace:Lumora.Enhance"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:SettingsViewModel}"
             d:DesignWidth="1000"
             d:DesignHeight="800">
    <!-- Einstellungen mit Reitern oben (ADR-0042, Mockup 06). Reiter-Tags = NavigationTags.SettingsSections; der gewählte
         Reiter wird im Code-Behind mit SettingsSectionState abgeglichen (Navigation von außen, z. B. „Tags verwalten…“).
         Bibliotheken & Eingänge, Tags und Kategorien sind die bisherigen Seiten (aus DI, eigener DataContext); die übrigen
         Reiter zeigen das SettingsViewModel (geerbt), Info ein eigenes InfoViewModel. -->
    <UserControl.Resources>
        <!-- Reiterleiste im WPF-UI-Stil („Pivot“): Text, gewählter Reiter fett mit Akzent-Strich unten -->
        <Style x:Key="PivotItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,4,0" Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="4,4,0,0" Background="Transparent" />
                            <ContentPresenter ContentSource="Header" Margin="12,8,12,10" RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Border x:Name="Indicator" Height="3" CornerRadius="2" VerticalAlignment="Bottom" Margin="12,0,12,-1"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PivotTabs" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource PivotItem}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Margin="24,0,24,0" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TextBlock Grid.Row="0" FontTypography="Title" Text="Einstellungen" Margin="24,12,24,12" />

        <TabControl x:Name="Tabs" Grid.Row="2" Style="{StaticResource PivotTabs}"
                    AutomationProperties.Name="Bereiche der Einstellungen">
            <TabItem x:Name="LibraryTab" Header="Bibliotheken &amp; Eingänge" Tag="{x:Static shell:NavigationTags.Library}" />
            <TabItem x:Name="TagsTab" Header="Tags" Tag="{x:Static shell:NavigationTags.Tags}" />
            <TabItem x:Name="CategoriesTab" Header="Kategorien" Tag="{x:Static shell:NavigationTags.Categories}" />
            <TabItem Header="Gesichter" Tag="{x:Static shell:NavigationTags.SettingsFaces}">
                <sections:SettingsFacesSection />
            </TabItem>
            <!-- Motive (ADR-0052): DataContext = MotifSettingsViewModel (Code-Behind) -->
            <TabItem Header="Motive" Tag="{x:Static shell:NavigationTags.SettingsMotifs}">
                <sections:SettingsMotifsSection x:Name="MotifsView" />
            </TabItem>
            <!-- Verbessern (ADR-0071, Mockup 13): DataContext = EnhanceSettingsViewModel (Code-Behind) -->
            <TabItem Header="Verbessern" Tag="{x:Static shell:NavigationTags.SettingsEnhance}">
                <enhance:SettingsEnhanceSection x:Name="EnhanceView" />
            </TabItem>
            <TabItem Header="Archive" Tag="{x:Static shell:NavigationTags.SettingsArchives}">
                <sections:SettingsArchivesSection />
            </TabItem>
            <TabItem Header="Darstellung" Tag="{x:Static shell:NavigationTags.SettingsAppearance}">
                <sections:SettingsAppearanceSection x:Name="AppearanceView" />
            </TabItem>
            <!-- Storys (ADR-0060): Story-Arten, Erkennung, Highlights, Diashow; DataContext = StorySettingsViewModel (Code-Behind) -->
            <TabItem Header="Storys" Tag="{x:Static shell:NavigationTags.SettingsStories}">
                <stories:SettingsStoriesSection x:Name="StoriesView" />
            </TabItem>
            <!-- Assistent (ADR-0063): Ollama, Sprachmodell, Grafikkarte, Verlauf; DataContext = AssistantSettingsViewModel (Code-Behind) -->
            <TabItem Header="Assistent" Tag="{x:Static shell:NavigationTags.SettingsAssistant}">
                <assistant:SettingsAssistantSection x:Name="AssistantView" />
            </TabItem>
            <!-- Orte (ADR-0062): Garmin-Aktivitäten und Zeitabgleich; DataContext = PlacesSettingsViewModel (Code-Behind) -->
            <TabItem Header="Orte" Tag="{x:Static shell:NavigationTags.SettingsPlaces}">
                <tracks:SettingsPlacesSection x:Name="PlacesView" />
            </TabItem>
            <!-- Modelle & Daten (ADR-0070): DataContext = ModelPackagesViewModel (Code-Behind) -->
            <TabItem Header="Modelle &amp; Daten" Tag="{x:Static shell:NavigationTags.SettingsModels}">
                <models:SettingsModelPackagesSection x:Name="ModelsView" />
            </TabItem>
            <TabItem Header="Speicher &amp; Wartung" Tag="{x:Static shell:NavigationTags.SettingsStorage}">
                <sections:SettingsStorageSection x:Name="StorageView" />
            </TabItem>
            <TabItem Header="Info" Tag="{x:Static shell:NavigationTags.SettingsInfo}">
                <info:InfoSection x:Name="InfoView" />
            </TabItem>
        </TabControl>

        <!-- Meldungen des SettingsViewModel (alle Reiter außer den eingebetteten Seiten, die eigene haben) -->
        <StackPanel Grid.Row="1" Margin="24,0,24,0">
            <ui:InfoBar Title="Fehler" Severity="Error" Message="{Binding ErrorMessage}"
                        IsOpen="{Binding IsErrorOpen, Mode=TwoWay}" Margin="0,0,0,12" />
            <ui:InfoBar Severity="Success" Message="{Binding InfoMessage}"
                        IsOpen="{Binding IsInfoOpen, Mode=TwoWay}" Margin="0,0,0,12" />
        </StackPanel>
    </Grid>
</UserControl>
