<UserControl x:Class="Lumora.Gallery.Controls.GalleryFilterCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:gc="clr-namespace:Lumora.Gallery.Controls"
             xmlns:conv="clr-namespace:Lumora.Gallery.Converters"
             xmlns:tags="clr-namespace:Lumora.Gallery.Tags"
             xmlns:cats="clr-namespace:Lumora.Gallery.Categories"
             xmlns:people="clr-namespace:Lumora.Gallery.People"
             xmlns:places="clr-namespace:Lumora.Gallery.Places"
             xmlns:tours="clr-namespace:Lumora.Gallery.Tours"
             xmlns:motifs="clr-namespace:Lumora.Gallery.Motifs"
             xmlns:vm="clr-namespace:Lumora.Gallery.ViewModels"
             xmlns:albums="clr-namespace:Lumora.Albums"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GalleryViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="1028"
             x:Name="Root"
             Focusable="False">
    <!--
        Filterkarte der Galerie (0.2.43, Mockup 06; seit 0.4.1 eigenes Steuerelement, ADR-0055). DataContext =
        GalleryViewModel (Singleton) — Galerie, Ordner und Orte binden DIESELBE Karte an DENSELBEN Filterzustand:
          Zeile „Datei“ (Dateiart, nur Favoriten, Bewertung, Ablage, Filter zurücksetzen), Zeile „Inhalt“ (Tags, Personen,
          Motive, Album, Kategorien, Ort, Doppelte), Fußzeile „Es gilt: … UND … → n Treffer“ nur bei aktiven Filtern.
        Alle Zeilen sind ToolbarFlowPanel: bei 1280 DIP Fensterbreite einzeilig, darunter brechen sie sauber um.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GalleryFilterStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="FilterCard"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel>
            <!-- Zeile „Datei“ -->
            <gc:ToolbarFlowPanel x:Name="FileRow" Margin="14,10,14,4" Spacing="6">
                <TextBlock Text="DATEI" Width="54" Style="{StaticResource GalleryFilterRowLabel}" />

                <!-- Dateiart -->
                <Border x:Name="MediaSegment" Style="{StaticResource GallerySegmentHost}"
                        AutomationProperties.Name="Dateiart">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource GallerySegmentRadio}" GroupName="{Binding MediaGroupName, ElementName=Root}" Content="Alle"
                                     AutomationProperties.Name="Alle Dateiarten"
                                     IsChecked="{Binding MediaFilter, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                        <RadioButton Style="{StaticResource GallerySegmentRadio}" GroupName="{Binding MediaGroupName, ElementName=Root}" AutomationProperties.Name="Bilder"
                                     IsChecked="{Binding MediaFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Images}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Image24" FontSize="12" Margin="0,0,4,0" />
                                <TextBlock Text="Bilder" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource GallerySegmentRadio}" GroupName="{Binding MediaGroupName, ElementName=Root}" AutomationProperties.Name="Videos"
                                     IsChecked="{Binding MediaFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Videos}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Video24" FontSize="12" Margin="0,0,4,0" />
                                <TextBlock Text="Videos" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource GallerySegmentRadio}" GroupName="{Binding MediaGroupName, ElementName=Root}" AutomationProperties.Name="Archive"
                                     ToolTip="ZIP-, RAR- und 7z-Archive"
                                     IsChecked="{Binding MediaFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Archives}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderZip24" FontSize="12" Margin="0,0,4,0" />
                                <TextBlock Text="Archive" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Nur Favoriten (Umschalter) -->
                <ToggleButton x:Name="FavoritesChip"
                              Style="{StaticResource GalleryFilterChip}"
                              AutomationProperties.AutomationId="GalleryFavoritesFilter"
                              AutomationProperties.Name="Nur Favoriten"
                              ToolTip="Nur Dateien mit Herz zeigen"
                              IsChecked="{Binding FavoritesOnly, Mode=TwoWay}"
                              gc:FilterChip.IsActive="{Binding FavoritesOnly}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Heart24" FontSize="13" Margin="0,0,6,0" Filled="{Binding FavoritesOnly}" />
                        <TextBlock Text="Nur Favoriten" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <!-- Bewertung -->
                <gc:GalleryRatingFilterDropDown />

                <!-- Ablage (ADR-0020): Eingang / Bibliothek -->
                <gc:GalleryStatusFilterDropDown />

                <!-- Abstandhalter: schiebt „Filter zurücksetzen“ an den rechten Rand -->
                <Border gc:ToolbarFlowPanel.Fill="True" MinWidth="0" Height="1" />

                <ui:Button x:Name="ResetFiltersButton"
                           Height="32"
                           Padding="10,0"
                           AutomationProperties.AutomationId="GalleryResetFilters"
                           AutomationProperties.Name="Filter zurücksetzen"
                           ToolTip="Alle Filter und die Suche aufheben — in Galerie, Ordner und Orte (die Ordnerauswahl bleibt)"
                           Command="{Binding ResetFiltersCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FilterDismiss24" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="Filter zurücksetzen" VerticalAlignment="Center" FontSize="13" />
                        <Border Margin="6,0,0,0"
                                MinWidth="18" Height="18"
                                Padding="5,0"
                                CornerRadius="9"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ActiveFilterCount}"
                                       FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                </ui:Button>
            </gc:ToolbarFlowPanel>

            <!-- Zeile „Inhalt“ -->
            <gc:ToolbarFlowPanel x:Name="ContentRow" Margin="14,4,14,10" Spacing="6">
                <TextBlock Text="INHALT" Width="54" Style="{StaticResource GalleryFilterRowLabel}" />

                <!-- Tag-Filter (ODER/UND/ohne Tag), ADR-0021 -->
                <tags:TagFilterDropDown />

                <!-- Personen-Filter (0.2.38) — sobald Personen oder Gesichter da sind -->
                <people:PersonFilterDropDown Visibility="{Binding ShowPersonFilter, Converter={StaticResource BoolToVis}}" />

                <!-- Motiv-Filter (ADR-0052) — sobald Motive erkannt wurden -->
                <motifs:MotifFilterDropDown Visibility="{Binding ShowMotifFilter, Converter={StaticResource BoolToVis}}" />

                <!-- Album-Filter (ADR-0054) — sobald es Alben gibt -->
                <albums:AlbumFilterDropDown Visibility="{Binding ShowAlbumFilter, Converter={StaticResource BoolToVis}}" />

                <!-- Kategorien-Filter (ADR-0027) — nur wenn Kategorien angelegt sind -->
                <cats:CategoryFilterDropDown Visibility="{Binding HasCategories, Converter={StaticResource BoolToVis}}" />

                <!-- Ort-Filter (ADR-0050): Land → Region → Ort, „ohne Ort“ -->
                <places:PlaceFilterDropDown />

                <!-- Tour (ADR-0073 Stufe 7, Mockup 24): Fotos aus der Zeit einer Tour verbundener Apps -->
                <tours:TourFilterDropDown Visibility="{Binding ShowTourFilter, Converter={StaticResource BoolToVis}}" />

                <!-- Nur Doppelte (ADR-0053): Dateien mit byte-gleichem Inhalt im Bereich — Zeile „Inhalt“ (in „Datei“ bräche sie bei 1280 DIP um) -->
                <ToggleButton x:Name="DuplicatesChip"
                              Style="{StaticResource GalleryFilterChip}"
                              AutomationProperties.AutomationId="GalleryDuplicatesFilter"
                              AutomationProperties.Name="Nur Doppelte"
                              ToolTip="Nur Dateien, die es im Bereich byte-gleich ein zweites Mal gibt (aufräumen auf der Seite „Doppelte“)"
                              IsChecked="{Binding DuplicatesOnly, Mode=TwoWay}"
                              gc:FilterChip.IsActive="{Binding DuplicatesOnly}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DocumentCopy24" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="Doppelte" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <!-- Lieblinge (ADR-0072): Fotos mit gelernter Vorliebe aus der Nutzung — Zeile „Inhalt“ (in „Datei“ bräche sie bei 1280 DIP um) -->
                <ToggleButton x:Name="LovedChip"
                              Style="{StaticResource GalleryFilterChip}"
                              AutomationProperties.AutomationId="GalleryLovedFilter"
                              AutomationProperties.Name="Lieblinge"
                              ToolTip="Nur Fotos, die Lumora aus Ihrer Nutzung gelernt hat: oft und an mehreren Tagen angesehen, verwendet oder weitergegeben (Favoriten und Sterne sind eigene Filter)"
                              IsChecked="{Binding LovedOnly, Mode=TwoWay}"
                              gc:FilterChip.IsActive="{Binding LovedOnly}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="HeartPulse24" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="Lieblinge" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
            </gc:ToolbarFlowPanel>

            <!-- Fußzeile: wirkende Bedingungen in Worten (nur bei aktiven Filtern) -->
            <Border x:Name="ActiveRow"
                    Padding="14,8"
                    CornerRadius="0,0,8,8"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                    AutomationProperties.Name="Aktive Filter"
                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Es gilt:" FontSize="13" Margin="0,3,8,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ItemsControl Grid.Column="1"
                                  x:Name="ConditionList"
                                  Focusable="False"
                                  ItemsSource="{Binding ActiveConditions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GalleryFilterCondition}">
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                    <TextBlock x:Name="And" Text="UND" FontSize="11" FontWeight="Bold" Margin="6,0,6,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Grid>
                                        <Border CornerRadius="4" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.12" />
                                        <StackPanel Orientation="Horizontal" Margin="8,2,3,2">
                                            <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Button Style="{StaticResource ChipButton}"
                                                    Margin="4,0,0,0"
                                                    ToolTip="Diese Bedingung entfernen"
                                                    AutomationProperties.Name="{Binding Label, StringFormat='Bedingung {0} entfernen'}"
                                                    Command="{Binding DataContext.RemoveFilterConditionCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Dismiss16" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                        <Setter TargetName="And" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <!-- Trefferzahl der Galerie; auf der Karte ausgeblendet (die Karte zählt selbst) -->
                        <TextBlock FontSize="13" Margin="12,3,0,0" VerticalAlignment="Top"
                                   AutomationProperties.AutomationId="GalleryActiveHits"
                                   Visibility="{Binding ShowHitCount, ElementName=Root, Converter={StaticResource BoolToVis}}">
                            <Run Text="→ " Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text="{Binding TotalCount, StringFormat=N0, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" Treffer" />
                        </TextBlock>
                        <!-- Intelligentes Album aus dem aktuellen Filter (ADR-0054) -->
                        <ui:Button Margin="12,0,0,0" Padding="8,2" Appearance="Transparent"
                                   AutomationProperties.AutomationId="GallerySaveSmartAlbum"
                                   AutomationProperties.Name="Als intelligentes Album speichern"
                                   ToolTip="Diesen Filter als intelligentes Album speichern — es füllt sich selbst"
                                   Command="{Binding SaveAsSmartAlbumCommand}"
                                   Visibility="{Binding HasAlbumSupport, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Sparkle16" FontSize="12" Margin="0,0,4,0" />
                                <TextBlock Text="Als Album speichern…" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
