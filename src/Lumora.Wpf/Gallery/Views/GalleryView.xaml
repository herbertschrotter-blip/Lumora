<UserControl x:Class="Lumora.Gallery.Views.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Lumora.Gallery.Controls"
             xmlns:data="clr-namespace:Lumora.Gallery.Data"
             xmlns:vm="clr-namespace:Lumora.Gallery.ViewModels"
             xmlns:conv="clr-namespace:Lumora.Gallery.Converters"
             xmlns:gc="clr-namespace:Lumora.Gallery.Controls"
             xmlns:marks="clr-namespace:Lumora.Marks"
             xmlns:rows="clr-namespace:Lumora.Gallery.FolderRows"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GalleryViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="1000"
             d:DesignHeight="700"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
        <!-- Collage-Vorlage (ADR-0044): eigenes Wörterbuch, damit Tests die echte Vorlage laden -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="GalleryCollageTemplates.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />

        <!-- Rechtsklick-Menü der Kachel und der Listenzeile (ADR-0068, Mockup 17): beim Öffnen im Code-Behind über
             PhotoContextMenuBuilder gebaut (gleiche Struktur wie in der Lightbox). Der Knopf „Tags“ der Aktionsleiste hat ein
             eigenes, schlankes Tag-Menü (OnTagMenuOpened). -->
        <ContextMenu x:Key="TagContextMenu" Opened="OnPhotoMenuOpened" />

        <!-- Rahmenloser Overlay-Button auf der Kachel (Herz) — kein Hover-Chrome über dem Bild -->
        <Style x:Key="TileOverlayButton" TargetType="Button">
            <Setter Property="Background" Value="#66000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kachel-Container: eigene Vorlage statt Standard-ListBoxItem (kein Highlight-Flackern),
             Auswahl = 2px Rahmen in Akzentfarbe + Häkchen oben links. -->
        <Style x:Key="TileContainerStyle" TargetType="ListBoxItem">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="6">
                            <Border x:Name="Frame"
                                    CornerRadius="6"
                                    BorderThickness="2"
                                    BorderBrush="Transparent"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <Border CornerRadius="5" ClipToBounds="True">
                                    <ContentPresenter />
                                </Border>
                            </Border>
                            <Border x:Name="Check"
                                    Width="20" Height="20"
                                    CornerRadius="10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="8"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed">
                                <ui:SymbolIcon Symbol="Checkmark24"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
            <EventSetter Event="ContextMenuOpening" Handler="OnTileContextMenuOpening" />
            <Setter Property="ContextMenu" Value="{StaticResource TagContextMenu}" />
        </Style>

        <!-- Kachel-Inhalt -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:GalleryItem}">
            <Grid x:Name="Tile" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Medienbereich; Tooltip „Aufgenommen: …“ (ADR-0046) -->
                <Grid Grid.Row="0" ClipToBounds="True" Background="Transparent" ToolTip="{Binding CaptureDateToolTip}">
                    <!-- Platzhalter (Bild), solange kein Thumbnail da ist -->
                    <ui:SymbolIcon Symbol="Image24"
                                   FontSize="48"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsVideo, Converter={StaticResource InverseBoolToVis}}" />

                    <!-- Echtes Vorschaubild (null → Platzhalter bleibt sichtbar) -->
                    <Image x:Name="Thumb"
                           Source="{Binding Thumbnail}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- Archiv (ADR-0022): Icon + Endung + Größe statt Vorschaubild -->
                    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            Visibility="{Binding IsArchive, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Viewbox: SymbolIcon übernahm im Kachel-Container die FontSize nicht (Icon blieb 16 px) -->
                            <Viewbox Width="40" Height="40" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Archive24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Viewbox>
                            <Border Margin="0,6,0,0" Padding="8,2" CornerRadius="3" HorizontalAlignment="Center"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <TextBlock Text="{Binding ArchiveBadge}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <TextBlock Text="{Binding SizeDisplay}" Margin="0,4,0,0" FontSize="11" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Video: Play-Overlay (immer sichtbar) -->
                    <Border Width="36" Height="36"
                            CornerRadius="18"
                            Background="#8C000000"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Badges oben mittig: „fehlt“ und „Eingang“ (Datei unter einer Eingangs-Wurzel, ADR-0020) -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,6,0,0"
                                IsHitTestVisible="False">
                        <Border Padding="6,1"
                                Margin="0,0,3,0"
                                CornerRadius="3"
                                Background="#CCC42B1C"
                                Visibility="{Binding Missing, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Warning16" FontSize="11" Foreground="White" Margin="0,0,3,0" />
                                <TextBlock Text="fehlt" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Padding="6,1"
                                CornerRadius="3"
                                Background="#CC0F6CBD"
                                Visibility="{Binding IsInbox, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="MailInbox16" FontSize="11" Foreground="White" Margin="0,0,3,0" />
                                <TextBlock Text="Eingang" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <!-- Nur über eine Verknüpfung in diesem Ordner (ADR-0054) -->
                        <Border Padding="6,1" Margin="3,0,0,0" CornerRadius="3" Background="#CC5B4FC4"
                                Visibility="{Binding IsLinked, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Link16" FontSize="11" Foreground="White" Margin="0,0,3,0" />
                                <TextBlock Text="verknüpft" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Tag- und Kategorie-Marke oben links (Mockup 16): nur wenn gesetzt und Schalter „Auf Galerie-Kacheln“ an.
                         Bei Auswahl rechts neben dem Häkchen, bei „fehlt“/„Eingang“/„verknüpft“ unter diesen Badges. -->
                    <marks:TileMarksControl x:Name="Marks"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="6,6,0,0"
                                            Tags="{Binding Tags}"
                                            Categories="{Binding Categories}"
                                            ShowMarks="{Binding Path=(gc:GalleryListBox.TileHost).ShowTileMarks, RelativeSource={RelativeSource Self}}" />

                    <!-- Herz oben rechts: Toggle Favorit (sichtbar wenn gesetzt, sonst bei Hover) -->
                    <Button x:Name="HeartButton"
                            Style="{StaticResource TileOverlayButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,4,4,0"
                            Opacity="0"
                            ToolTip="Favorit umschalten"
                            AutomationProperties.Name="Favorit umschalten"
                            Command="{Binding Path=(gc:GalleryListBox.TileHost).ToggleFavoriteCommand, RelativeSource={RelativeSource Self}}"
                            CommandParameter="{Binding}">
                        <ui:SymbolIcon x:Name="HeartIcon"
                                       Symbol="Heart24"
                                       FontSize="16"
                                       Foreground="White"
                                       Filled="{Binding IsFavorite}" />
                    </Button>

                    <!-- Extension-Badge unten links -->
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="4,0,0,4"
                            Padding="6,1"
                            CornerRadius="3"
                            IsHitTestVisible="False"
                            Background="{DynamicResource AccentFillColorTertiaryBrush}">
                        <TextBlock Text="{Binding Extension}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>

                    <!-- Fassungs-Marke „2 Fassungen“ (ADR-0071, Mockup 13) über der Endung: Klick öffnet Original + Fassungen -->
                    <Button Style="{StaticResource TileOverlayButton}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="4,0,0,24"
                            Padding="0"
                            Background="Transparent"
                            MinWidth="0"
                            MinHeight="0"
                            ToolTip="Original und verbesserte Fassung öffnen"
                            AutomationProperties.Name="{Binding VariantText}"
                            Visibility="{Binding HasVariants, Converter={StaticResource BoolToVis}}"
                            Command="{Binding Path=(gc:GalleryListBox.TileHost).OpenVariantsCommand, RelativeSource={RelativeSource Self}}"
                            CommandParameter="{Binding}">
                        <Border Padding="7,1" CornerRadius="8" Background="#99000000">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ImageMultiple16" FontSize="11" Foreground="White" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding VariantText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- Sterne unten rechts: Bewertung (sichtbar wenn gesetzt, sonst bei Hover) -->
                    <Border x:Name="StarsHost"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,4,4"
                            Padding="4,2"
                            CornerRadius="9"
                            Background="#66000000"
                            Opacity="0">
                        <gc:RatingStars Value="{Binding Rating}"
                                        StarSize="11"
                                        FilledBrush="#FFD166"
                                        EmptyBrush="#CCFFFFFF"
                                        Command="{Binding Path=(gc:GalleryListBox.TileHost).SetItemRatingCommand, RelativeSource={RelativeSource Self}}"
                                        CommandParameter="{Binding}" />
                    </Border>
                </Grid>

                <!-- Dateiname + Größe -->
                <Border Grid.Row="1"
                        Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                        Padding="8,4">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}"
                                   ToolTip="{Binding SourcePath}"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="11" />
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding SizeDisplay}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <!-- Personen (0.2.38): Symbol mit Anzahl bestätigter Personen, Hover zeigt die Namen -->
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        ToolTip="{Binding Persons.ToolTip}"
                                        Visibility="{Binding Persons.HasConfirmed, Converter={StaticResource BoolToVis}}">
                                <ui:SymbolIcon Symbol="Person16" FontSize="11" Margin="0,0,2,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Persons.ConfirmedCount}" FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <!-- Unbenannte Gesichter (0.2.39): dezentes graues Symbol mit Anzahl (unbestätigt/Vorschlag), ignorierte zählen nicht -->
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        ToolTip="{Binding Persons.UnnamedToolTip}"
                                        Visibility="{Binding Persons.HasUnnamed, Converter={StaticResource BoolToVis}}">
                                <ui:SymbolIcon Symbol="PersonQuestionMark16" FontSize="11" Margin="0,0,2,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{Binding Persons.UnnamedCount}" FontSize="10"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <!-- Tag-Punkte unter der Kachel seit 0.4.35 ersetzt durch die Tag-Marke oben links (Mockup 16) -->
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="HeartButton" Property="Opacity" Value="1" />
                    <Setter TargetName="StarsHost" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter TargetName="HeartButton" Property="Opacity" Value="1" />
                    <Setter TargetName="HeartIcon" Property="Foreground" Value="#FF6B6B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasRating}" Value="True">
                    <Setter TargetName="StarsHost" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Missing}" Value="True">
                    <Setter TargetName="Thumb" Property="Opacity" Value="0.45" />
                    <Setter TargetName="Marks" Property="Margin" Value="6,28,0,0" />
                </DataTrigger>
                <!-- Mockup 16: Marken weichen dem Auswahl-Häkchen (oben links) und den Badges oben mittig aus -->
                <DataTrigger Binding="{Binding IsInbox}" Value="True">
                    <Setter TargetName="Marks" Property="Margin" Value="6,28,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLinked}" Value="True">
                    <Setter TargetName="Marks" Property="Margin" Value="6,28,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Marks" Property="Padding" Value="24,0,0,0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Ansicht „Ordner“ (Mockup 21): Foto einer Zeile — Bild füllt die Breite, Schild „erstes“/„letztes“ -->
        <Style x:Key="FolderRowTileButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="FolderRowTileTemplate" DataType="{x:Type rows:FolderRowTile}">
            <Button Width="{Binding Width}"
                    Margin="0,0,4,0"
                    Style="{StaticResource FolderRowTileButton}"
                    ToolTip="{Binding Item.Name}"
                    AutomationProperties.Name="{Binding Item.Name}"
                    Command="{Binding DataContext.OpenFolderRowTileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Grid ClipToBounds="True">
                    <Border CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Image Source="{Binding Item.Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border x:Name="EdgeBadge"
                            Visibility="Collapsed"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="5"
                            Padding="7,1,7,2"
                            CornerRadius="9"
                            Background="#8C000000">
                        <TextBlock x:Name="EdgeText" FontSize="10" Foreground="White" />
                    </Border>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                    <Setter TargetName="EdgeBadge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="EdgeText" Property="Text" Value="erstes" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLast}" Value="True">
                    <Setter TargetName="EdgeBadge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="EdgeText" Property="Text" Value="letztes" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Ansicht „Ordner“: eine Zeile je Unterordner — Kopf (Name öffnet den Ordner, Zeitraum, Anzahl, Knöpfe beim
             Darüberfahren), darunter die Fotos in Zeilenhöhe (Regler). Rechtsklick: Aktionen für das Set (Code-Behind). -->
        <DataTemplate x:Key="FolderRowTemplate" DataType="{x:Type rows:FolderRowViewModel}">
            <Border x:Name="RowBorder"
                    Margin="0,0,0,10"
                    Padding="8,4,4,8"
                    CornerRadius="8"
                    Background="Transparent"
                    ContextMenuOpening="OnFolderRowContextMenuOpening"
                    AutomationProperties.AutomationId="GalleryFolderRow"
                    AutomationProperties.Name="{Binding Name}">
                <Border.ContextMenu>
                    <ContextMenu />
                </Border.ContextMenu>
                <StackPanel>
                    <DockPanel Margin="0,0,0,6" LastChildFill="True">
                        <StackPanel x:Name="RowActions" DockPanel.Dock="Right" Orientation="Horizontal" Opacity="0">
                            <ui:Button Appearance="Transparent" Padding="6,3" Icon="{ui:SymbolIcon ArrowShuffle24}" ToolTip="Andere Fotos zeigen"
                                       Command="{Binding DataContext.ShuffleFolderRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}" />
                            <ui:Button Appearance="Transparent" Padding="6,3" Icon="{ui:SymbolIcon Play24}" ToolTip="Diashow dieses Ordners"
                                       Command="{Binding DataContext.StartFolderRowSlideshowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}" />
                            <ui:Button Appearance="Transparent" Padding="6,3" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Ordner öffnen"
                                       Command="{Binding DataContext.OpenFolderRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}" />
                        </StackPanel>
                        <ui:SymbolIcon Symbol="Folder24" Filled="True" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Hyperlink Command="{Binding DataContext.OpenFolderRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}"
                                       TextDecorations="{x:Null}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       ToolTip="{Binding Path}">
                                <Run Text="{Binding Name, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                            </Hyperlink>
                            <Run Text="  " />
                            <Run Text="{Binding DateText, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Run Text=" · " FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Run Text="{Binding InfoText, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </TextBlock>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Tiles}"
                                  ItemTemplate="{StaticResource FolderRowTileTemplate}"
                                  Height="{Binding DataContext.TileSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  ClipToBounds="True"
                                  Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter TargetName="RowActions" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding IsNested}" Value="True">
                    <Setter TargetName="RowBorder" Property="Margin" Value="24,0,0,10" />
                    <Setter TargetName="RowBorder" Property="BorderThickness" Value="2,0,0,0" />
                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Unterordner-Kachel (Container-State) -->
        <DataTemplate x:Key="SubfolderTemplate" DataType="{x:Type data:GallerySubfolderDto}">
            <ui:Button Width="168" Height="124"
                       Margin="6"
                       Padding="12"
                       HorizontalContentAlignment="Stretch"
                       VerticalContentAlignment="Stretch"
                       ToolTip="{Binding Path}"
                       AutomationProperties.Name="{Binding Name}"
                       Command="{Binding DataContext.OpenSubfolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                       CommandParameter="{Binding}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Folder24"
                                   FontSize="36"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Name}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Center"
                               MaxWidth="140"
                               Margin="0,8,0,2" />
                    <TextBlock Text="{Binding FileCountDisplay}"
                               FontSize="11"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ui:Button>
        </DataTemplate>

        <!-- Collage-Container (ADR-0044): Rand 3 = halbe Fuge (JustifiedTilePanel.ItemSpacing 6), Bild füllt die Zelle;
             Auswahl = Rahmen in Akzentfarbe ÜBER dem Bild + Häkchen; Doppelklick und Kontextmenü wie bei den Kacheln. -->
        <Style x:Key="CollageContainerStyle" TargetType="ListBoxItem">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="3">
                            <Border CornerRadius="4" ClipToBounds="True" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Frame" CornerRadius="4" BorderThickness="3" BorderBrush="Transparent" IsHitTestVisible="False" />
                            <Border x:Name="Check"
                                    Width="20" Height="20"
                                    CornerRadius="10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="7"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed">
                                <ui:SymbolIcon Symbol="Checkmark24"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
            <EventSetter Event="ContextMenuOpening" Handler="OnTileContextMenuOpening" />
            <Setter Property="ContextMenu" Value="{StaticResource TagContextMenu}" />
        </Style>

        <!-- Panels der Galerie-ListBox: Kacheln (feste Größe aus dem Regler) bzw. Collage (Reihenhöhe aus dem Regler) -->
        <ItemsPanelTemplate x:Key="TilePanelTemplate">
            <controls:VirtualizingTilePanel ItemWidth="{Binding TileWidth}" ItemHeight="{Binding TileHeight}" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="CollagePanelTemplate">
            <controls:JustifiedTilePanel TargetRowHeight="{Binding TileSize}" ItemSpacing="6" LayoutVersion="{Binding CollageLayoutVersion}" />
        </ItemsPanelTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="Left" Command="{Binding PrevPageCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Right" Command="{Binding NextPageCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Home" Command="{Binding FirstPageCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="End" Command="{Binding LastPageCommand}" />
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="M" Command="{Binding ArchiveSelectionCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="T" Command="{Binding EditSelectionTagsCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="K" Command="{Binding EditSelectionCategoriesCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="L" Command="{Binding AddSelectionToNamedAlbumCommand}" />
        <!-- Strg+F: Suchfeld der Kopfzeile (0.2.43) -->
        <KeyBinding Modifiers="Ctrl" Key="F" Command="ApplicationCommands.Find" />
    </UserControl.InputBindings>

    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" />
    </UserControl.CommandBindings>

    <Grid Margin="16,8,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Library-Root offline (unter der Kopfzeile, direkt über dem Inhalt) -->
        <ui:InfoBar Grid.Row="1"
                    Margin="0,0,0,8"
                    Severity="Warning"
                    IsClosable="False"
                    Title="Bibliotheksordner nicht erreichbar"
                    Message="Der Ordner der Bibliothek ist offline. Vorschaubilder, Lightbox und Dateiaktionen stehen erst wieder zur Verfügung, wenn er erreichbar ist."
                    IsOpen="{Binding IsRootOffline, Mode=OneWay}" />

        <!-- Kopfzeile (0.2.43, Mockup 06): Titel + Trefferzeile + Suche, Filterkarte, Sortier- und Ansichtsleiste -->
        <gc:GalleryToolbar x:Name="Toolbar" Grid.Row="0" Margin="0,0,0,8" IsEnabled="{Binding HasLibrary}" />

        <!-- Inhalt -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid>
                <!-- Kachel-Grid bzw. Collage: eine Page (≤ 1000 Items), Mehrfachauswahl. UI-virtualisiert (VirtualizingTilePanel
                     bzw. JustifiedTilePanel): Container nur für sichtbare Zeilen plus Puffer, pixelbasiertes Scrollen über
                     IScrollInfo (dafür CanContentScroll=True), Container-Recycling. Panel, Vorlage und Container-Stil
                     wechseln je Ansicht im Code-Behind (ADR-0044). -->
                <controls:GalleryListBox x:Name="GalleryList"
                         AutomationProperties.AutomationId="GalleryList"
                         ItemsSource="{Binding CurrentPage}"
                         SelectionMode="Extended"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         KeyboardNavigation.DirectionalNavigation="Contained"
                         KeyDown="OnListKeyDown"
                         PreviewMouseWheel="OnGridPreviewMouseWheel"
                         PreviewKeyDown="OnGridPreviewKeyDown"
                         controls:VirtualizingTilePanel.VisibleRangeChanged="OnVisibleRangeChanged"
                         Visibility="{Binding ShowGalleryList, Converter={StaticResource BoolToVis}}">
                    <!-- Start = Kacheln; Collage setzt der Code-Behind (ApplyGalleryViewMode) als lokale Werte. Kein Stil-Trigger:
                         dessen Neubewertung beim Seitenwechsel löste beim Entfernen von Items Binding-Fehler aus (Rauchtest). -->
                    <controls:GalleryListBox.ItemTemplate><StaticResource ResourceKey="TileTemplate" /></controls:GalleryListBox.ItemTemplate>
                    <controls:GalleryListBox.ItemContainerStyle><StaticResource ResourceKey="TileContainerStyle" /></controls:GalleryListBox.ItemContainerStyle>
                    <controls:GalleryListBox.ItemsPanel><StaticResource ResourceKey="TilePanelTemplate" /></controls:GalleryListBox.ItemsPanel>
                    <controls:GalleryListBox.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding RecycleSelectionCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}" />
                        <KeyBinding Modifiers="Ctrl" Key="A" Command="{Binding SelectAllCommand}" />
                    </controls:GalleryListBox.InputBindings>
                </controls:GalleryListBox>

                <!-- Listenansicht (0.2.6): DataGrid über dieselbe Page; Spalten/Sortierung in Gallery/ListView.
                     Wird erst beim ersten Umschalten erzeugt (Code-Behind), damit der Start im Kachel-Modus nichts kostet. -->
                <ContentControl x:Name="ListViewHost"
                                Focusable="False"
                                IsTabStop="False"
                                Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}" />

                <!-- Container-State: Unterordner-Kacheln -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="8"
                              Visibility="{Binding ShowSubfolders, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Margin="12,8,12,4"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap">
                            <Run Text="Dieser Ordner enthält keine Dateien direkt. Wähle einen Unterordner:" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Subfolders}"
                                      ItemTemplate="{StaticResource SubfolderTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Ansicht „Ordner“ (Mockup 21): je Unterordner eine Zeile, virtualisiert -->
                <DockPanel Visibility="{Binding ShowFolderRows, Converter={StaticResource BoolToVis}}">
                    <DockPanel DockPanel.Dock="Top" Margin="16,8,16,4" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Erstes und letztes Foto jedes Ordners stehen außen, dazwischen zufällige in Aufnahme-Reihenfolge." />
                        <ui:Button DockPanel.Dock="Right" Content="Neu mischen" Icon="{ui:SymbolIcon ArrowShuffle24}"
                                   AutomationProperties.AutomationId="GalleryFolderRowsShuffle"
                                   ToolTip="Andere zufällige Fotos in allen Zeilen (erstes und letztes bleiben)"
                                   Command="{Binding ShuffleFolderRowsCommand}" />
                    </DockPanel>
                    <ItemsControl x:Name="FolderRowsList"
                                  AutomationProperties.AutomationId="GalleryFolderRows"
                                  ItemsSource="{Binding FolderRows}"
                                  ItemTemplate="{StaticResource FolderRowTemplate}"
                                  Padding="12,4,12,12"
                                  Focusable="False"
                                  SizeChanged="OnFolderRowsSizeChanged"
                                  PreviewMouseWheel="OnGridPreviewMouseWheel"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" Padding="{TemplateBinding Padding}">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>

                <!-- Leerzustand: keine Bibliothek -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="420"
                            Visibility="{Binding ShowNoLibrary, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="Library24" FontSize="48"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    <ui:TextBlock FontTypography="Subtitle" Text="Noch keine Bibliothek"
                                  TextAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="Lege unter „Bibliothek“ eine Bibliothek an und starte den Scan — danach erscheinen hier die Fotos und Videos."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Leerzustand: keine Treffer -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="420"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="48"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    <ui:TextBlock FontTypography="Subtitle" Text="Nichts gefunden"
                                  TextAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="{Binding EmptyMessage}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Fehler -->
                <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                        BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16"
                        Margin="12"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="Galerie meldet einen Fehler" />
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding DbPathDisplay, StringFormat='DB: {0}'}"
                                   FontSize="11"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Schwebende Aktionsleiste (bei ≥ 1 ausgewählt) -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,16"
                        Padding="6"
                        CornerRadius="8"
                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        IsEnabled="{Binding IsOperationRunning, Converter={StaticResource InverseBool}}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectionText}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,12,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <Border Width="1" Margin="0,4,6,4" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <ui:Button Appearance="Transparent" Content="Favorit"
                                   Icon="{ui:SymbolIcon Heart24, Filled=True}"
                                   ToolTip="Auswahl als Favorit markieren"
                                   Command="{Binding FavoriteSelectionCommand}" />
                        <ui:Button Appearance="Transparent" Content="Entfernen"
                                   Icon="{ui:SymbolIcon Heart24}"
                                   ToolTip="Favorit bei Auswahl entfernen"
                                   AutomationProperties.Name="Favorit entfernen"
                                   Command="{Binding UnfavoriteSelectionCommand}" />

                        <Border Width="1" Margin="6,4,6,4" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <gc:RatingStars Value="{Binding SelectionRating}"
                                        StarSize="18"
                                        VerticalAlignment="Center"
                                        Margin="4,0"
                                        FilledBrush="#FFD166"
                                        EmptyBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                        ToolTip="Bewertung für die Auswahl setzen"
                                        Command="{Binding SetSelectionRatingCommand}" />
                        <ui:Button Appearance="Transparent" ToolTip="Bewertung bei Auswahl löschen"
                                   AutomationProperties.Name="Bewertung löschen"
                                   Icon="{ui:SymbolIcon StarOff24}"
                                   Command="{Binding ClearSelectionRatingCommand}" />

                        <Border Width="1" Margin="6,4,6,4" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <!-- Tags: Menü mit Häkchen je Tag (Zuweisen/Entfernen für die Auswahl) + Dialog (Strg+T) -->
                        <!-- Flyout = eigene ContextMenu-Instanz aus dem Code-Behind (nicht dieselbe wie auf Kacheln/Zeilen). -->
                        <ui:DropDownButton x:Name="TagsDropDown"
                                           Appearance="Transparent" Content="Tags"
                                           Icon="{ui:SymbolIcon Tag24}"
                                           ToolTip="Tags der Auswahl setzen oder entfernen (Strg+T öffnet die Tag-Auswahl)"
                                           AutomationProperties.Name="Tags" />
                        <!-- Alben (ADR-0054): zu einem Album hinzufügen (Strg+L), hier verknüpfen; Menü im Code-Behind (GalleryView.Albums.cs) -->
                        <ui:DropDownButton x:Name="AlbumsDropDown"
                                           Appearance="Transparent" Content="Album"
                                           Icon="{ui:SymbolIcon Album24}"
                                           ToolTip="Auswahl zu einem Album hinzufügen oder in einen Ordner verknüpfen — nichts wird kopiert (Strg+L)"
                                           AutomationProperties.Name="Album"
                                           Visibility="{Binding HasAlbumSupport, Converter={StaticResource BoolToVis}}" />
                        <!-- Aufnahmedatum setzen (ADR-0046) -->
                        <ui:Button Appearance="Transparent" Content="Datum…"
                                   Icon="{ui:SymbolIcon CalendarEdit24}"
                                   ToolTip="Aufnahmedatum der Auswahl setzen, ungefähr angeben oder verschieben (nur im Katalog)"
                                   AutomationProperties.Name="Datum setzen"
                                   Command="{Binding SetSelectionCaptureDateCommand}" />
                        <!-- Ort setzen (ADR-0050) -->
                        <ui:Button Appearance="Transparent" Content="Ort…"
                                   Icon="{ui:SymbolIcon Location24}"
                                   ToolTip="Ort der Auswahl setzen oder entfernen (JPEG: EXIF, sonst XMP-Begleitdatei, Videos: nur Katalog)"
                                   AutomationProperties.Name="Ort setzen"
                                   Command="{Binding SetSelectionPlaceCommand}" />

                        <Border Width="1" Margin="6,4,6,4" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <ui:Button Appearance="Transparent" Content="Verschieben nach…"
                                   Icon="{ui:SymbolIcon FolderArrowRight24}"
                                   Command="{Binding MoveSelectionCommand}" />
                        <ui:Button Appearance="Transparent" Content="In die Bibliothek…"
                                   Icon="{ui:SymbolIcon Archive24}"
                                   ToolTip="Auswahl in den Bibliotheksordner verschieben (Strg+M)"
                                   Command="{Binding ArchiveSelectionCommand}" />
                        <ui:Button Appearance="Transparent" Content="Papierkorb"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   ToolTip="Auswahl in den Papierkorb verschieben (Entf)"
                                   Command="{Binding RecycleSelectionCommand}" />
                        <!-- ADR-0065: fehlende Dateien aus der Bibliothek entfernen (nur Katalog, keine Datei wird gelöscht) -->
                        <ui:Button Appearance="Transparent" Content="Aus der Bibliothek entfernen"
                                   Icon="{ui:SymbolIcon DismissCircle24}"
                                   ToolTip="Fehlende Dateien der Auswahl aus der Bibliothek entfernen — es wird keine Datei gelöscht"
                                   AutomationProperties.Name="Aus der Bibliothek entfernen"
                                   Command="{Binding RemoveMissingSelectionCommand}"
                                   Visibility="{Binding ShowRemoveMissingAction, Converter={StaticResource BoolToVis}}" />
                        <ui:Button Appearance="Transparent" Content="Entpacken…"
                                   Icon="{ui:SymbolIcon FolderZip24}"
                                   ToolTip="Ausgewählte Archive entpacken"
                                   Command="{Binding ExtractSelectionCommand}"
                                   Visibility="{Binding CanExtractSelection, Converter={StaticResource BoolToVis}}" />

                        <Border Width="1" Margin="6,4,6,4" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <ui:Button Appearance="Transparent" ToolTip="Alle Dateien dieser Seite auswählen (Strg+A)"
                                   AutomationProperties.Name="Alle auswählen"
                                   Icon="{ui:SymbolIcon SelectAllOn24}"
                                   Command="{Binding SelectAllCommand}" />
                        <ui:Button Appearance="Transparent" ToolTip="Auswahl aufheben (Esc)"
                                   AutomationProperties.Name="Auswahl aufheben"
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   Command="{Binding ClearSelectionCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Blättern und Seitengröße unter der Galerie (0.2.43, Mockup 06): „‹ Seite 1 von 7 › · Pro Seite [200 ▾]“ -->
        <StackPanel x:Name="PagerBar" Grid.Row="4" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Center"
                    AutomationProperties.Name="Seiten">
            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ChevronDoubleLeft20}" ToolTip="Erste Seite (Strg+Pos1)" AutomationProperties.Name="Erste Seite"
                       Command="{Binding FirstPageCommand}" Margin="0,0,2,0" />
            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ChevronLeft24}" ToolTip="Vorherige Seite (Strg+←)" AutomationProperties.Name="Vorherige Seite"
                       Command="{Binding PrevPageCommand}" Margin="0,0,8,0" />
            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       AutomationProperties.AutomationId="GalleryPageText">
                <Run Text="Seite " /><Run Text="{Binding DisplayPageIndex, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Run Text=" von " /><Run Text="{Binding PageCount, StringFormat=N0, Mode=OneWay}" />
            </TextBlock>
            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ChevronRight24}" ToolTip="Nächste Seite (Strg+→)" AutomationProperties.Name="Nächste Seite"
                       Command="{Binding NextPageCommand}" Margin="8,0,2,0" />
            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ChevronDoubleRight20}" ToolTip="Letzte Seite (Strg+Ende)" AutomationProperties.Name="Letzte Seite"
                       Command="{Binding LastPageCommand}" />
            <Border Width="1" Height="20" Margin="12,0" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <TextBlock Text="Pro Seite" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ComboBox MinWidth="80"
                      AutomationProperties.AutomationId="GalleryPageSizeCombo"
                      AutomationProperties.Name="Dateien pro Seite"
                      ItemsSource="{Binding PageSizeOptions}"
                      SelectedItem="{Binding PageSize, Mode=TwoWay}"
                      ToolTip="Dateien pro Seite" />
        </StackPanel>

        <!-- Status / Telemetrie -->
        <Border Grid.Row="5" Margin="0,8,0,0"
                Padding="10,6"
                Background="{DynamicResource LayerFillColorAltBrush}"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="14" Height="14"
                                     Margin="0,0,8,0"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding FirstPageLoadMs, StringFormat='Start: {0:N0} ms'}"
                               FontSize="12"
                               Margin="0,0,16,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding LastPageLoadMs, StringFormat='Letzte Seite: {0:N1} ms'}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
