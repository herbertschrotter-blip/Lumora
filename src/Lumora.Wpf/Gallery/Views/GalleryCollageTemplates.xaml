<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:vm="clr-namespace:Lumora.Gallery.ViewModels"
                    xmlns:conv="clr-namespace:Lumora.Gallery.Converters"
                    xmlns:gc="clr-namespace:Lumora.Gallery.Controls"
                    xmlns:marks="clr-namespace:Lumora.Marks">
    <!--
        Collage-Kachel (ADR-0044, Mockup 06): das Bild füllt die Zelle des JustifiedTilePanel ohne Beschnitt (die Zelle hat
        sein Seitenverhältnis; nur extrem hohe/breite Bilder werden mittig beschnitten). Kein Namensfeld unter dem Bild:
        Name als Tooltip und beim Darüberfahren unten eingeblendet. Favorit, Sterne, Video-Symbol und Personen wie bei den
        Kacheln als Overlay. Container-Stil (Rand 3 = halbe Fuge, Auswahlrahmen, Doppelklick, Kontextmenü) liegt in
        GalleryView.xaml (EventSetter brauchen dessen Code-Behind). Eigenes Wörterbuch, damit Tests die echte Vorlage laden.
    -->
    <BooleanToVisibilityConverter x:Key="CollageBoolToVis" />
    <conv:InverseBoolToVisibilityConverter x:Key="CollageInverseBoolToVis" />

    <!-- Rahmenloser Overlay-Button (Herz) — wie TileOverlayButton der Kacheln -->
    <Style x:Key="CollageOverlayButton" TargetType="Button">
        <Setter Property="Background" Value="#66000000" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="CollageTemplate" DataType="{x:Type vm:GalleryItem}">
        <Grid x:Name="Tile" Background="Transparent" ClipToBounds="True" ToolTip="{Binding Name}">
            <!-- Platzhalter (Bild), solange kein Vorschaubild da ist -->
            <ui:SymbolIcon Symbol="Image24"
                           FontSize="32"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsVideo, Converter={StaticResource CollageInverseBoolToVis}}" />

            <!-- Vorschaubild: Zelle hat sein Seitenverhältnis → UniformToFill füllt ohne sichtbaren Beschnitt -->
            <Image x:Name="Thumb"
                   Source="{Binding Thumbnail}"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Archiv (ADR-0022): 4:3-Zelle mit Icon + Endung + Größe -->
            <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    Visibility="{Binding IsArchive, Converter={StaticResource CollageBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox Width="36" Height="36" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Archive24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    </Viewbox>
                    <Border Margin="0,6,0,0" Padding="8,2" CornerRadius="3" HorizontalAlignment="Center"
                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBlock Text="{Binding ArchiveBadge}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="{Binding SizeDisplay}" Margin="0,4,0,0" FontSize="11" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Video: Play-Overlay (immer sichtbar) -->
            <Border Width="36" Height="36"
                    CornerRadius="18"
                    Background="#8C000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Visibility="{Binding IsVideo, Converter={StaticResource CollageBoolToVis}}">
                <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="18" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Badges oben mittig: „fehlt“ und „Eingang“ (ADR-0020) -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,6,0,0"
                        IsHitTestVisible="False">
                <Border Padding="6,1" Margin="0,0,3,0" CornerRadius="3" Background="#CCC42B1C"
                        Visibility="{Binding Missing, Converter={StaticResource CollageBoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Warning16" FontSize="11" Foreground="White" Margin="0,0,3,0" />
                        <TextBlock Text="fehlt" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Padding="6,1" CornerRadius="3" Background="#CC0F6CBD"
                        Visibility="{Binding IsInbox, Converter={StaticResource CollageBoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="MailInbox16" FontSize="11" Foreground="White" Margin="0,0,3,0" />
                        <TextBlock Text="Eingang" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <!-- Nur über eine Verknüpfung in diesem Ordner (ADR-0054) -->
                <Border Padding="5,1" Margin="3,0,0,0" CornerRadius="3" Background="#CC5B4FC4"
                        Visibility="{Binding IsLinked, Converter={StaticResource CollageBoolToVis}}">
                    <ui:SymbolIcon Symbol="Link16" FontSize="11" Foreground="White" />
                </Border>
            </StackPanel>

            <!-- Tag- und Kategorie-Marke oben links (Mockup 16): wie Herz/Sterne nur beim Darüberfahren, damit die Bilder ruhig bleiben -->
            <marks:TileMarksControl x:Name="Marks"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="6,6,0,0"
                                    Opacity="0"
                                    Tags="{Binding Tags}"
                                    Categories="{Binding Categories}"
                                    ShowMarks="{Binding DataContext.ShowTileMarks, RelativeSource={RelativeSource AncestorType=ListBox}}" />

            <!-- Herz oben rechts: Favorit (sichtbar wenn gesetzt, sonst beim Darüberfahren) -->
            <Button x:Name="HeartButton"
                    Style="{StaticResource CollageOverlayButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,4,4,0"
                    Opacity="0"
                    ToolTip="Favorit umschalten"
                    AutomationProperties.Name="Favorit umschalten"
                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}">
                <ui:SymbolIcon x:Name="HeartIcon" Symbol="Heart24" FontSize="16" Foreground="White" Filled="{Binding IsFavorite}" />
            </Button>

            <!-- Fußleiste: Personen links, Name in der Mitte (nur beim Darüberfahren), Sterne rechts -->
            <Grid x:Name="Footer" VerticalAlignment="Bottom">
                <Border x:Name="FooterShade" Opacity="0" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#99000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <DockPanel LastChildFill="True" Margin="4,10,4,4">
                    <!-- Personen (0.2.38/0.2.39): bestätigte und unbenannte Gesichter als dunkle Plakette -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Border Padding="5,2" Margin="0,0,3,0" CornerRadius="9" Background="#66000000"
                                ToolTip="{Binding Persons.ToolTip}"
                                Visibility="{Binding Persons.HasConfirmed, Converter={StaticResource CollageBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Person16" FontSize="11" Margin="0,0,2,0" Foreground="White" />
                                <TextBlock Text="{Binding Persons.ConfirmedCount}" FontSize="10" Foreground="White" />
                            </StackPanel>
                        </Border>
                        <Border Padding="5,2" CornerRadius="9" Background="#66000000"
                                ToolTip="{Binding Persons.UnnamedToolTip}"
                                Visibility="{Binding Persons.HasUnnamed, Converter={StaticResource CollageBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PersonQuestionMark16" FontSize="11" Margin="0,0,2,0" Foreground="#CCFFFFFF" />
                                <TextBlock Text="{Binding Persons.UnnamedCount}" FontSize="10" Foreground="#CCFFFFFF" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Sterne: Bewertung (sichtbar wenn gesetzt, sonst beim Darüberfahren) -->
                    <Border x:Name="StarsHost" DockPanel.Dock="Right" VerticalAlignment="Bottom"
                            Padding="4,2" CornerRadius="9" Background="#66000000" Opacity="0">
                        <gc:RatingStars Value="{Binding Rating}"
                                        StarSize="11"
                                        FilledBrush="#FFD166"
                                        EmptyBrush="#CCFFFFFF"
                                        Command="{Binding DataContext.SetItemRatingCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                    </Border>

                    <TextBlock x:Name="NameText"
                               Text="{Binding Name}"
                               Opacity="0"
                               Margin="4,0,6,1"
                               VerticalAlignment="Bottom"
                               FontSize="11"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False" />
                </DockPanel>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                <Setter TargetName="HeartButton" Property="Opacity" Value="1" />
                <Setter TargetName="StarsHost" Property="Opacity" Value="1" />
                <Setter TargetName="NameText" Property="Opacity" Value="1" />
                <Setter TargetName="FooterShade" Property="Opacity" Value="1" />
                <Setter TargetName="Marks" Property="Opacity" Value="1" />
            </Trigger>
            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                <Setter TargetName="HeartButton" Property="Opacity" Value="1" />
                <Setter TargetName="HeartIcon" Property="Foreground" Value="#FF6B6B" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasRating}" Value="True">
                <Setter TargetName="StarsHost" Property="Opacity" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Missing}" Value="True">
                <Setter TargetName="Thumb" Property="Opacity" Value="0.45" />
                <Setter TargetName="Marks" Property="Margin" Value="6,28,0,0" />
            </DataTrigger>
            <!-- Mockup 16: Marken weichen dem Auswahl-Häkchen und den Badges oben mittig aus -->
            <DataTrigger Binding="{Binding IsInbox}" Value="True">
                <Setter TargetName="Marks" Property="Margin" Value="6,28,0,0" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLinked}" Value="True">
                <Setter TargetName="Marks" Property="Margin" Value="6,28,0,0" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Marks" Property="Padding" Value="24,0,0,0" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
