<dialogs:AppFluentWindow x:Class="Lumora.Merge.MergeWindow"
                 xmlns:dialogs="clr-namespace:Lumora.Shell.Dialogs"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:Lumora.Lightbox.Controls"
                 xmlns:local="clr-namespace:Lumora.Merge"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance local:MergeViewModel, IsDesignTimeCreatable=False}"
                 Title="{Binding Title}"
                 Width="1280"
                 Height="820"
                 MinWidth="980"
                 MinHeight="640"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 AutomationProperties.AutomationId="MergeWindow"
                 KeyDown="OnKeyDown">
    <!-- Fenster „Zusammenfügen“ (ADR-0078 Punkt 8, Mockup 28 Ansichten 5 und 11, Stufe 1 Teil B): links Verfahren, Mitte Bühne +
         Filmstreifen, rechts Optionen bzw. Speichern/Fertig, unten der Fuß. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:MergeInverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <local:MergeNullToVisibilityConverter x:Key="NullToVis" />
        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ChoiceButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="304" />
            </Grid.ColumnDefinitions>

            <!-- ============ links: Verfahren ============ -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,4,12,14" IsEnabled="{Binding IsSetup}">
                    <StackPanel>
                        <Border CornerRadius="6" Padding="10,8" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding SourceInfo}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="MergeSourceInfo"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding SourceInfoDetail}" Style="{StaticResource Small}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SectionHead}" Text="VERFAHREN" />
                        <ItemsControl ItemsSource="{Binding Methods}" Focusable="False" AutomationProperties.AutomationId="MergeMethods">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:MergeMethodItem}">
                                    <Border x:Name="Row" CornerRadius="6" Padding="8,6" Margin="0,0,0,2" BorderThickness="1" BorderBrush="Transparent"
                                            AutomationProperties.Name="{Binding Name}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Border Margin="6,0,0,0" Padding="5,0" CornerRadius="4" VerticalAlignment="Center"
                                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                            Visibility="{Binding IsSuggested, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Vorschlag" FontSize="9" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Reason}" Style="{StaticResource Small}" />
                                            </StackPanel>
                                            <TextBlock x:Name="Fit" Grid.Column="1" Text="{Binding FitText}" FontSize="10" Margin="6,2,0,0" VerticalAlignment="Top"
                                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Suits}" Value="False">
                                            <Setter TargetName="Fit" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBuilt}" Value="False">
                                            <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                                            <Setter TargetName="Fit" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Margin="0,10,0,0" CornerRadius="6" Padding="10,8" BorderThickness="1"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="Info16" FontSize="13" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Warum dieser Vorschlag" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding WhyLines}" Focusable="False" AutomationProperties.AutomationId="MergeWhy">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Small}" Margin="0,1,0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============ Mitte: Hinweise, Bühne, Leiste, Filmstreifen ============ -->
            <Grid Grid.Column="1" Margin="12,0,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="0" ItemsSource="{Binding Notes}" Focusable="False" AutomationProperties.AutomationId="MergeNotes">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:MergeNoteItem}">
                            <Border x:Name="Strip" CornerRadius="6" Padding="10,6" Margin="0,0,0,6" BorderThickness="1"
                                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="Icon" Symbol="Info16" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" MaxWidth="640"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                    <Setter TargetName="Strip" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                    <Setter TargetName="Icon" Property="Symbol" Value="Warning16" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Error">
                                    <Setter TargetName="Strip" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                    <Setter TargetName="Icon" Property="Symbol" Value="ErrorCircle16" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Success">
                                    <Setter TargetName="Strip" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                    <Setter TargetName="Icon" Property="Symbol" Value="CheckmarkCircle16" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Bühne (dunkel wie in der Lightbox) -->
                <Border Grid.Row="1" CornerRadius="8" Background="#141414" ClipToBounds="True" AutomationProperties.AutomationId="MergeStage">
                    <Grid>
                        <controls:ZoomPanControl x:Name="Stage" Source="{Binding StageImage}"
                                                 Visibility="{Binding IsSetup, Converter={StaticResource BoolToVis}}">
                            <controls:ZoomPanControl.Overlay>
                                <local:MergeStageOverlay x:Name="StageOverlay"
                                                         FrameWidth="{Binding StageFrameWidth}"
                                                         Crop="{Binding StageCrop}"
                                                         CroppedImage="{Binding StageCroppedImage}"
                                                         ShowFrame="{Binding ShowFrame}"
                                                         Visibility="{Binding HasStageFrame, Converter={StaticResource BoolToVis}}" />
                            </controls:ZoomPanControl.Overlay>
                        </controls:ZoomPanControl>

                        <!-- leere Bühne bzw. Fehler -->
                        <TextBlock Text="{Binding StageMessage}" Foreground="#C8C8C8" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                                   AutomationProperties.AutomationId="MergeStageMessage"
                                   Visibility="{Binding StageMessage, Converter={StaticResource NullToVis}}" />

                        <!-- Fortschritt der Vorschau -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="14,8" CornerRadius="8"
                                Background="#CC000000" AutomationProperties.AutomationId="MergeProgress"
                                Visibility="{Binding IsComputing, Converter={StaticResource BoolToVis}}">
                            <StackPanel Width="280">
                                <TextBlock Text="{Binding ProgressText}" Foreground="White" FontSize="12" />
                                <ProgressBar Margin="0,6,0,0" Height="4" Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}" />
                                <TextBlock Text="Vorschau rechnet mit Vorrang — der Hintergrund wartet so lange." Foreground="#A0A0A0" FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Speichern: Schrittliste -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,18" CornerRadius="10" MaxWidth="560"
                                Background="{DynamicResource ApplicationBackgroundBrush}" AutomationProperties.AutomationId="MergeSaving"
                                Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SaveTitle}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding SaveSubtitle}" Style="{StaticResource Small}" Margin="0,2,0,10" />
                                <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:MergeStepItem}">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon x:Name="Dot" Symbol="Circle16" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <TextBlock x:Name="Text" Grid.Column="1" Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Small}" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                    <Setter TargetName="Dot" Property="Symbol" Value="CheckmarkCircle16" />
                                                    <Setter TargetName="Dot" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter TargetName="Dot" Property="Symbol" Value="PlayCircle16" />
                                                    <Setter TargetName="Dot" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                                                    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ProgressBar Margin="0,12,0,0" Height="6" Minimum="0" Maximum="1" Value="{Binding SaveFraction, Mode=OneWay}" />
                                <TextBlock Text="{Binding SaveProgressText}" Style="{StaticResource Small}" Margin="0,4,0,10" AutomationProperties.AutomationId="MergeSaveProgress" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Im Hintergrund weiterrechnen" Margin="0,0,8,0" Command="{Binding ContinueInBackgroundCommand}" />
                                    <ui:Button Content="Abbrechen" Command="{Binding CancelSaveCommand}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Small}" Margin="0,10,0,0"
                                           Text="„Im Hintergrund weiterrechnen“ schließt das Fenster und rechnet ohne Vorrang mit halben Kernen weiter — Fortschritt dann in der Aktivitäts-Anzeige. Abbrechen wirkt zwischen Schritten, Bildern und Bändern." />
                            </StackPanel>
                        </Border>

                        <!-- Fertig: Ergebnis -->
                        <Grid Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" Margin="16">
                            <Image Source="{Binding StageCroppedImage, TargetNullValue={x:Null}}" Stretch="Uniform"
                                   Visibility="{Binding HasStageFrame, Converter={StaticResource BoolToVis}}" />
                            <Image Source="{Binding StageImage, TargetNullValue={x:Null}}" Stretch="Uniform"
                                   Visibility="{Binding HasStageFrame, Converter={StaticResource InvBoolToVis}}" />
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="8,2" CornerRadius="9" Background="#99000000">
                                <TextBlock Text="{Binding MadeFromText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Leiste unter der Bühne -->
                <Grid Grid.Row="2" Margin="0,6,0,6" Visibility="{Binding IsSetup, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0" Content="Zuschnitt und Lücken" IsChecked="{Binding ShowFrame}" Padding="10,3" FontSize="11"
                                  IsEnabled="{Binding HasStageFrame}" AutomationProperties.Name="Zuschnitt und Lücken zeigen"
                                  ToolTip="Ungeschnittenes Panorama abgedunkelt mit Zuschnitt-Rahmen; Lücken schraffiert" />
                    <TextBlock Grid.Column="1" Text="{Binding StageLabel}" Style="{StaticResource Small}" Margin="12,0" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="MergeStageLabel" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button Content="−" Padding="10,2" Margin="0,0,4,0" Click="OnZoomOut" AutomationProperties.Name="Verkleinern" />
                        <ui:Button Content="Einpassen" Padding="10,2" Margin="0,0,4,0" Click="OnZoomFit" AutomationProperties.Name="Einpassen" />
                        <ui:Button Content="+" Padding="10,2" Click="OnZoomIn" AutomationProperties.Name="Vergrößern" />
                    </StackPanel>
                </Grid>

                <!-- Filmstreifen der Quellen -->
                <Grid Grid.Row="3" Margin="0,4,0,0" IsEnabled="{Binding OptionsEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Quellen" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding SourceSummary}" Style="{StaticResource Small}" AutomationProperties.AutomationId="MergeSourceSummary" />
                        <ui:Button Content="{Binding CheckAllText}" Margin="0,6,0,0" Padding="6,2" FontSize="11" Command="{Binding CheckAllCommand}"
                                   Visibility="{Binding HasUncheckedNeighbors, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <ListBox Grid.Column="1" ItemsSource="{Binding Sources}" Height="112" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="MergeFilmstrip"
                             VirtualizingPanel.IsVirtualizing="True" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="Margin" Value="0,0,4,0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:MergeSourceItem}">
                                <StackPanel Width="96" ToolTip="{Binding ToolTip}">
                                    <Grid x:Name="Thumb" Height="64" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanCheck}" MinWidth="0" Margin="3,2,0,0"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="{Binding Name}" />
                                        <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="#B3000000" Padding="3,1"
                                                Visibility="{Binding HasMark, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Mark}" FontSize="9" Foreground="White" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked}" Value="False">
                                        <Setter TargetName="Thumb" Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsReference}" Value="True">
                                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- ============ rechts: Optionen bzw. Fertig ============ -->
            <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,4,14,14" IsEnabled="{Binding OptionsEnabled}"
                                  Visibility="{Binding IsDone, Converter={StaticResource InvBoolToVis}}" AutomationProperties.AutomationId="MergeOptions">
                        <StackPanel>
                            <TextBlock Text="Panorama" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <TextBlock Style="{StaticResource SectionHead}" Text="AUFNAHMEART" />
                            <ItemsControl ItemsSource="{Binding Projections}" Focusable="False" AutomationProperties.AutomationId="MergeProjections">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:MergeProjectionItem}">
                                        <Button x:Name="Tile" Margin="0,0,6,6" Padding="8,6" HorizontalContentAlignment="Stretch" BorderThickness="1"
                                                AutomationProperties.Name="{Binding Title}"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                Command="{Binding DataContext.ChooseProjectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Projection}">
                                            <StackPanel>
                                                <Grid Height="26" Margin="0,0,0,4">
                                                    <Path Data="{Binding Sketch}" Stretch="Fill" Width="54" HorizontalAlignment="Left" StrokeThickness="1.4"
                                                          Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}" Fill="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4,0" CornerRadius="4"
                                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                            Visibility="{Binding IsSuggested, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Vorschlag" FontSize="9" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Hint}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Small}" Text="Umschalten setzt nur neu zusammen — ausgerichtet wird nicht noch einmal." />

                            <!-- Kugel 360°: Horizontstreifen | 2 : 1 (Abnahme Nr. 4) -->
                            <StackPanel Visibility="{Binding IsSphere, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="MergeSphereForm">
                                <TextBlock Style="{StaticResource SectionHead}" Text="KUGEL 360°" />
                                <RadioButton Style="{StaticResource ChoiceButton}" GroupName="Sphere" Content="Horizontstreifen (wie bisher in Photoshop)" IsChecked="{Binding IsSphereBand}" />
                                <RadioButton Style="{StaticResource ChoiceButton}" GroupName="Sphere" Content="2 : 1 · Rundum-Bild, Zenit/Nadir gefüllt, für 360°-Betrachter" IsChecked="{Binding IsSphereFull}" />
                                <TextBlock Style="{StaticResource Small}" Text="Vorausgewählt ist die zuletzt gewählte Form (Einstellungen › Zusammenfügen)." />
                            </StackPanel>

                            <TextBlock Style="{StaticResource SectionHead}" Text="ZUSCHNITT" />
                            <StackPanel AutomationProperties.AutomationId="MergeCrop">
                                <RadioButton Style="{StaticResource ChoiceButton}" GroupName="Crop" Content="Gerade Kanten" IsChecked="{Binding IsCropStraight}"
                                             ToolTip="Nur Bildinhalt — kein gefülltes Pixel" />
                                <RadioButton Style="{StaticResource ChoiceButton}" GroupName="Crop" Content="Lücken füllen" IsChecked="{Binding IsCropFill}" />
                                <RadioButton Style="{StaticResource ChoiceButton}" GroupName="Crop" Content="Ungeschnitten" IsChecked="{Binding IsCropNone}" />
                            </StackPanel>

                            <ui:ToggleSwitch Margin="0,10,0,0" Content="Belichtung ausgleichen" IsChecked="{Binding Exposure}" />

                            <!-- Farbe kräftiger (Herbert 2026-11-18): 0 = aus, 100 = Standard, bis 150 -->
                            <TextBlock Style="{StaticResource SectionHead}" Text="FARBE KRÄFTIGER" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="{Binding ColorBoostMax, Mode=OneTime}" Value="{Binding ColorBoost}" TickFrequency="10" IsSnapToTickEnabled="True"
                                        SmallChange="10" LargeChange="25" AutomationProperties.Name="Farbe kräftiger" AutomationProperties.AutomationId="MergeColorBoost" />
                                <TextBlock Grid.Column="1" Text="{Binding ColorBoostText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="64"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <ui:Button Content="Aus" Padding="8,2" FontSize="11" Margin="0,0,6,0" Command="{Binding SetColorBoostCommand}" CommandParameter="0" />
                                <ui:Button Content="Standard 100 %" Padding="8,2" FontSize="11" Command="{Binding SetColorBoostCommand}" CommandParameter="100" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Small}" Margin="0,4,0,0"
                                       Text="Buntheit wie in Photoshop; Helligkeit und Kontrast bleiben. „Aus“ bleibt treu zu den Quellen. Der Regler tont nur neu und wird gemerkt." />

                            <TextBlock Style="{StaticResource SectionHead}" Text="GRÖSSE" />
                            <ItemsControl ItemsSource="{Binding Sizes}" Focusable="False" AutomationProperties.AutomationId="MergeSizes">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:MergeSizeItem}">
                                        <Border x:Name="Size" CornerRadius="6" Padding="8,5" Margin="0,0,0,4" BorderThickness="1"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Size" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                <Setter TargetName="Size" Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Small}" Text="Volle Auflösung ist Standard. Reicht der Arbeitsspeicher nicht oder wäre eine Kante länger als 65 500 px (JPEG), nimmt Lumora die größte passende Stufe." />

                            <TextBlock Style="{StaticResource SectionHead}" Text="ERGEBNIS" />
                            <Border CornerRadius="6" Padding="8,6" Opacity="0.55" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel>
                                    <TextBlock Text="Danach hochskalieren · kommt später" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Style="{StaticResource Small}" Text="Nur nach dem Zusammenfügen, gedämpft, mit dem Modell aus „Foto verbessern“ (Stufe 4)." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Fertig-Ansicht -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,4,14,14" AutomationProperties.AutomationId="MergeDone"
                                  Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="Fertig" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <Border Margin="0,10,0,10" HorizontalAlignment="Left" Padding="8,3" CornerRadius="10" Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <TextBlock Text="{Binding MadeFromText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                           AutomationProperties.AutomationId="MergeMadeFrom" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding DoneRows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:MergeInfoRow}">
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Small}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:Button Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,8,0,6" Command="{Binding OpenCommand}" AutomationProperties.Name="Öffnen">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Open24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Öffnen" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Content="In der Galerie zeigen" HorizontalAlignment="Stretch" Margin="0,0,0,6" Command="{Binding ShowInGalleryCommand}" />
                            <ui:Button Content="Rückgängig" HorizontalAlignment="Stretch" Margin="0,0,0,6" Command="{Binding UndoCommand}" />
                            <ui:Button Content="Danach verbessern…" HorizontalAlignment="Stretch" Margin="0,0,0,6" Command="{Binding EnhanceAfterCommand}" />
                            <ui:Button Content="Im Explorer zeigen" HorizontalAlignment="Stretch" Margin="0,0,0,6" Command="{Binding ShowInExplorerCommand}"
                                       IsEnabled="{Binding CanShowInExplorer}" ToolTip="{Binding ExplorerToolTip}" ToolTipService.ShowOnDisabled="True" />
                            <TextBlock Style="{StaticResource Small}" Text="{Binding DoneNote}" Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Fuß ============ -->
        <Border Grid.Row="2" Padding="16,10" Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="{Binding TargetName}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="MergeTargetName" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding PlaceText}" Style="{StaticResource Small}" />
                </StackPanel>
                <WrapPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" IsEnabled="{Binding OptionsEnabled}"
                           Visibility="{Binding IsDone, Converter={StaticResource InvBoolToVis}}">
                    <CheckBox Content="{Binding AlbumText}" IsChecked="{Binding AlsoAlbum}" Margin="0,0,14,0" FontSize="12"
                              AutomationProperties.AutomationId="MergeAlsoAlbum"
                              Visibility="{Binding HasAlbum, Converter={StaticResource BoolToVis}}" />
                    <CheckBox Content="gemeinsame Tags" IsChecked="{Binding CopyTags}" Margin="0,0,14,0" FontSize="12"
                              ToolTip="Nur Tags, die alle Quellen tragen" />
                    <CheckBox Content="Sterne und Favorit" IsChecked="{Binding CopyRating}" Margin="0,0,14,0" FontSize="12"
                              ToolTip="Höchste Sternezahl der Quellen; Favorit, wenn eine Quelle Favorit ist" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding EstimateText}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   AutomationProperties.AutomationId="MergeEstimate" />
                        <TextBlock Text="{Binding EstimateDetail}" Style="{StaticResource Small}" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Text="{Binding DoneDuration}" Style="{StaticResource Small}"
                           Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Verwerfen" Margin="0,0,8,0" Command="{Binding DiscardCommand}"
                               Visibility="{Binding IsDone, Converter={StaticResource InvBoolToVis}}" />
                    <ui:Button Appearance="Primary" Command="{Binding SaveCommand}" AutomationProperties.Name="Als neue Datei speichern"
                               Visibility="{Binding IsDone, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Als neue Datei speichern" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Primary" Content="Schließen" Command="{Binding CloseCommand}"
                               Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dialogs:AppFluentWindow>
