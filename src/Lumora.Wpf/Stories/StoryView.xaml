<UserControl x:Class="Lumora.Stories.StoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Lumora.Stories"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:StoryViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="1100"
             d:DesignHeight="760">
    <!-- Story-Ansicht (ADR-0060, Mockup 09): Brotkrumen, dann eine virtualisierte Liste (Titelbild, Tagesabschnitte mit
         Collage-Blöcken bzw. dichter Collage, Ende-Kasten). Die Leiste Highlights/Alle Fotos · Tage · Diashow liegt
         darüber und bleibt oben stehen, sobald das Titelbild hinausgescrollt ist. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="StoriesResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Foto-Kachel (Collage-Block und dichte Reihe) -->
            <DataTemplate x:Key="StoryTileTemplate" DataType="{x:Type local:StoryTileViewModel}">
                <local:StoryLeafButton Style="{StaticResource StoryTileButton}" Width="{Binding Width}" Height="{Binding Height}"
                                       AutomationProperties.Name="{Binding AutomationText}"
                                       ToolTip="{Binding ToolTipText}"
                                       Command="{Binding Owner.TileClickCommand}"
                                       DoubleClickCommand="{Binding Owner.OpenTileCommand}"
                                       CommandParameter="{Binding}">
                    <local:StoryLeafButton.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Öffnen" Icon="{ui:SymbolIcon Open24}" InputGestureText="Doppelklick"
                                      Command="{Binding Owner.OpenTileCommand}"
                                      CommandParameter="{Binding}" />
                            <!-- ADR-0068: „Als Titelbild für ▸“ — diese Story, Personen im Foto, Alben, Ordner -->
                            <MenuItem Header="Als Titelbild für" Icon="{ui:SymbolIcon ImageMultiple24}"
                                      SubmenuOpened="OnCoverSubmenuOpened"
                                      AutomationProperties.Name="Als Titelbild für">
                                <MenuItem Header="Wird geladen…" IsEnabled="False" />
                            </MenuItem>
                            <MenuItem Header="Aus Story entfernen" Icon="{ui:SymbolIcon Subtract24}"
                                      ToolTip="Nur aus dieser Story — das Foto bleibt in der Galerie"
                                      Command="{Binding Owner.RemoveTileCommand}"
                                      CommandParameter="{Binding}" />
                        </ContextMenu>
                    </local:StoryLeafButton.ContextMenu>
                    <Grid>
                        <Border CornerRadius="5" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <local:StoryImage CornerRadius="5" Opacity="{Binding Opacity}" Source="{Binding Image}" />
                        <!-- Video: Play-Symbol und Dauer -->
                        <Grid Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False">
                            <Ellipse Width="46" Height="46" Fill="#73000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Style="{StaticResource StoryImageBadge}" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Visibility="{Binding DurationText, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="White" />
                            </Border>
                        </Grid>
                        <!-- Serie: „+4 ähnliche“ -->
                        <Border Style="{StaticResource StoryImageBadge}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Visibility="{Binding SimilarText, Converter={StaticResource NullToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="11" Foreground="White" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding SimilarText}" FontSize="11" Foreground="White" />
                            </StackPanel>
                        </Border>
                        <!-- Favorit -->
                        <ui:SymbolIcon Symbol="Star24" Filled="True" FontSize="14" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Foreground="#FFF2B01E" IsHitTestVisible="False"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                        <!-- warum ausgewählt (beim Überfahren) -->
                        <Border CornerRadius="4" Background="#99000000" Padding="7,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                IsHitTestVisible="False" MaxWidth="{Binding Width}">
                            <Border.Visibility>
                                <MultiBinding Converter="{x:Static local:StoryVisibility.AllTrue}">
                                    <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=local:StoryLeafButton}" />
                                    <Binding Path="IsHighlight" />
                                </MultiBinding>
                            </Border.Visibility>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Info16" FontSize="11" Foreground="White" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding ToolTipText}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <!-- zum Entfernen markiert -->
                        <Border CornerRadius="5" BorderThickness="3" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Background="#33000000"
                                IsHitTestVisible="False" Visibility="{Binding IsMarked, Converter={StaticResource BoolToVis}}">
                            <Border Width="26" Height="26" CornerRadius="13" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                    </Grid>
                </local:StoryLeafButton>
            </DataTemplate>

            <!-- Zeile: Titelbild mit sachlicher Überschrift -->
            <DataTemplate DataType="{x:Type local:StoryCoverRow}">
                <Grid Height="340" Margin="0,0,0,0">
                    <Border CornerRadius="10" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <local:StoryImage CornerRadius="10" Source="{Binding Story.CoverImage}" />
                    <Border CornerRadius="0,0,10,10" VerticalAlignment="Bottom" Height="210" Background="{StaticResource StoryCaptionShade}" />
                    <StackPanel VerticalAlignment="Bottom" Margin="26,0,280,22">
                        <StackPanel Orientation="Horizontal" Opacity="0.92">
                            <ui:SymbolIcon Symbol="{Binding Story.KindSymbol}" FontSize="12" Foreground="White" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Story.Kicker}" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                       AutomationProperties.AutomationId="StoryKicker" />
                        </StackPanel>
                        <TextBlock Text="{Binding Story.Title}" FontSize="38" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="StoryTitle" />
                        <TextBlock Text="{Binding Story.PlacesText}" FontSize="16" Foreground="White" Opacity="0.95" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Story.PlacesText, Converter={StaticResource NullToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Opacity="0.85">
                            <TextBlock Text="{Binding Story.CountsText}" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Story.PersonsText}" FontSize="13" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding Story.PersonsText, Converter={StaticResource NullToVis}}" />
                            <ItemsControl ItemsSource="{Binding Story.Avatars}" ItemTemplate="{StaticResource StoryAvatarTemplate}" Margin="14,0,0,0"
                                          Focusable="False" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="6,0,0,0" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                    <!-- oben rechts: weitere Aktionen -->
                    <Button Style="{StaticResource StoryGlassButton}" Padding="9,5" Margin="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="Weitere Aktionen" AutomationProperties.Name="Weitere Aktionen" AutomationProperties.AutomationId="StoryMenu"
                            Click="OnMenuButtonClick">
                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="14" Foreground="White" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Titel ändern…" Icon="{ui:SymbolIcon Edit24}" InputGestureText="nur eigener Text" Command="{Binding Story.RenameCommand}" />
                                <MenuItem Header="Sachliche Überschrift" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding Story.ResetTitleCommand}"
                                          Visibility="{Binding Story.HasCustomTitle, Converter={StaticResource BoolToVis}}" />
                                <MenuItem Header="Titelbild wählen" Icon="{ui:SymbolIcon ImageMultiple24}" Command="{Binding Story.PickCoverCommand}" />
                                <MenuItem Header="Fotos hinzufügen…" Icon="{ui:SymbolIcon Add24}" Command="{Binding Story.AddPhotosCommand}"
                                          ToolTip="In der Galerie Fotos auswählen → Rechtsklick „Zur Story … hinzufügen“" />
                                <MenuItem Header="Fotos entfernen…" Icon="{ui:SymbolIcon Subtract24}" Command="{Binding Story.BeginRemoveCommand}" />
                                <Separator />
                                <MenuItem Header="{Binding Story.PinText}" Icon="{ui:SymbolIcon Pin24}" Command="{Binding Story.TogglePinCommand}" />
                                <MenuItem Header="Als Album speichern" Icon="{ui:SymbolIcon Album24}" Command="{Binding Story.SaveAsAlbumCommand}" />
                                <MenuItem Header="In der Galerie zeigen" Icon="{ui:SymbolIcon Image24}" Command="{Binding Story.ShowInGalleryCommand}" />
                                <Separator />
                                <MenuItem Header="Ausblenden" Icon="{ui:SymbolIcon EyeOff24}" Command="{Binding Story.HideCommand}" />
                                <MenuItem Header="Neu berechnen" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding Story.RecomputeCommand}" />
                                <MenuItem Header="Story löschen…" Icon="{ui:SymbolIcon Delete24}" Command="{Binding Story.DeleteCommand}"
                                          Visibility="{Binding Story.CanDelete, Converter={StaticResource BoolToVis}}" />
                                <Separator />
                                <MenuItem Header="Als Collage-Bild speichern…" Icon="{ui:SymbolIcon SlideMultiple24}"
                                          InputGestureText="{Binding Story.CollageHint}" Command="{Binding Story.SaveCollageCommand}"
                                          AutomationProperties.AutomationId="StoryCollageMenu" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <!-- unten rechts: Titelbild, Anheften -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="22">
                        <Button Style="{StaticResource StoryGlassButton}" Margin="0,0,8,0" Command="{Binding Story.PickCoverCommand}"
                                ToolTip="Titelbild wählen: Klick auf ein Foto der Story">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="12" Foreground="White" Margin="0,0,6,0" />
                                <TextBlock Text="Titelbild" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource StoryGlassButton}" Command="{Binding Story.TogglePinCommand}"
                                AutomationProperties.AutomationId="StoryPin">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Pin24" FontSize="12" Foreground="White" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Story.PinText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- Zeile: Platz unter dem Titelbild für die fixierte Leiste -->
            <DataTemplate DataType="{x:Type local:StoryBarSpacerRow}">
                <Border Height="{x:Static local:StoryBarSpacerRow.Height}" />
            </DataTemplate>

            <!-- Zeile: Kopf eines Tagesabschnitts -->
            <DataTemplate DataType="{x:Type local:StoryDayHeaderRow}">
                <DockPanel Margin="0,26,0,12" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Kicker}" FontSize="12" FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,12,4"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Bottom"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,0,3" VerticalAlignment="Bottom"
                                Visibility="{Binding HasPlaces, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="Location16" FontSize="13" Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding Places}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountsText}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </DockPanel>
            </DataTemplate>

            <!-- Zeile: Collage-Block bzw. Reihe der dichten Collage -->
            <DataTemplate DataType="{x:Type local:StoryTilesRow}">
                <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource StoryTileTemplate}" Focusable="False"
                              Height="{Binding Height}" Width="{Binding Width}" HorizontalAlignment="Left"
                              Loaded="OnTilesRowLoaded">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </DataTemplate>

            <!-- Zeile: „Alle n Fotos dieses Abschnitts“ / „Nur Highlights zeigen“ -->
            <DataTemplate DataType="{x:Type local:StoryDayFooterRow}">
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding Note}" FontSize="13" Margin="0,0,12,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource StoryLinkButton}"
                            Command="{Binding Owner.ToggleDayCommand}"
                            CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="12" Margin="0,0,6,0">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="ChevronDown24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Symbol" Value="ChevronUp24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock Text="{Binding Text}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DataTemplate>

            <!-- Zeile: eingeklappte weitere Tage -->
            <DataTemplate DataType="{x:Type local:StoryCollapsedRow}">
                <Border Margin="0,26,0,0" Padding="18,14" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Anzeigen" AutomationProperties.AutomationId="StoryShowAllDays"
                                   Command="{Binding Owner.ShowAllDaysNowCommand}" />
                        <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Run Text=" · " />
                            <Run Text="{Binding Text, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </Border>
            </DataTemplate>

            <!-- Zeile: Ende der Story -->
            <DataTemplate DataType="{x:Type local:StoryEndRow}">
                <Border Margin="0,34,0,24" Padding="20" CornerRadius="10" BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="Als Album speichern" Icon="{ui:SymbolIcon Album24}" Margin="0,0,8,0"
                                       Command="{Binding Story.SaveAsAlbumCommand}" />
                            <ui:Button Appearance="Primary" Content="Diashow" Icon="{ui:SymbolIcon Play24}"
                                       Visibility="{Binding Story.HasSlideshow, Converter={StaticResource BoolToVis}}"
                                       Command="{Binding Story.StartSlideshowCommand}" />
                        </StackPanel>
                        <ui:SymbolIcon Symbol="BookOpen24" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ende der Story" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Story.EndText}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       AutomationProperties.AutomationId="StoryEndText" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,12,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Brotkrumen -->
        <StackPanel Orientation="Horizontal" Margin="0,0,16,10">
            <Button Style="{StaticResource StoryLinkButton}" Command="{Binding BackCommand}" AutomationProperties.AutomationId="StoryBack"
                    AutomationProperties.Name="Zurück zu den Storys">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="Storys" />
                </StackPanel>
            </Button>
            <TextBlock Text="›" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{Binding Section}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Meldungen und Auswahl-Modus -->
        <StackPanel Grid.Row="1" Margin="0,0,16,0">
            <ui:InfoBar Message="{Binding ErrorText}" Severity="Error" IsClosable="False" Margin="0,0,0,8"
                        IsOpen="{Binding ErrorText, Converter={StaticResource NullToBool}, Mode=OneWay}"
                        Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}" />
            <ui:InfoBar Message="{Binding StatusText}" Severity="Success" IsClosable="False" Margin="0,0,0,8"
                        AutomationProperties.AutomationId="StoryStatus"
                        IsOpen="{Binding StatusText, Converter={StaticResource NullToBool}, Mode=OneWay}"
                        Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}" />
            <Border Margin="0,0,0,8" Padding="14,8" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="{Binding IsPicking, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Content="Automatisch" Margin="0,0,6,0" ToolTip="Titelbild wieder automatisch wählen"
                                   Visibility="{Binding IsPickingCover, Converter={StaticResource BoolToVis}}"
                                   Command="{Binding AutomaticCoverCommand}" />
                        <ui:Button Appearance="Primary" Content="Entfernen" Margin="0,0,6,0"
                                   Visibility="{Binding IsRemoving, Converter={StaticResource BoolToVis}}"
                                   Command="{Binding ConfirmRemoveCommand}" />
                        <ui:Button Content="Abbrechen" Command="{Binding CancelPickCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PickHint}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}" Focusable="False"
                          AutomationProperties.AutomationId="StoryRows"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Standard"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True"
                          SizeChanged="OnRowsSizeChanged"
                          ScrollViewer.ScrollChanged="OnRowsScrollChanged">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="Scroller" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsPresenter Margin="0,0,18,0" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Fixierte Leiste: Highlights/Alle Fotos · Tage · Diashow -->
            <Border x:Name="Bar" VerticalAlignment="Top" Height="{x:Static local:StoryBarSpacerRow.Height}" Margin="0,0,34,0"
                    Padding="0,10" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="BarShift" Y="340" />
                </Border.RenderTransform>
                <DockPanel>
                    <Border DockPanel.Dock="Left" CornerRadius="6" Padding="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <local:StorySelectButton Style="{StaticResource StorySegButton}" IsChecked="{Binding IsHighlightsMode, Mode=OneWay}" Command="{Binding ShowHighlightsCommand}"
                                    AutomationProperties.AutomationId="StoryModeHighlights" AutomationProperties.Name="Highlights">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Sparkle16" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Highlights" />
                                    <TextBlock Text="{Binding HighlightCount}" Margin="6,0,0,0" FontWeight="Normal" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </local:StorySelectButton>
                            <local:StorySelectButton Style="{StaticResource StorySegButton}" IsChecked="{Binding IsAllMode, Mode=OneWay}" Command="{Binding ShowAllPhotosCommand}"
                                    AutomationProperties.AutomationId="StoryModeAll" AutomationProperties.Name="Alle Fotos">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Alle Fotos" />
                                    <TextBlock Text="{Binding AllCount}" Margin="6,0,0,0" FontWeight="Normal" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </local:StorySelectButton>
                        </StackPanel>
                    </Border>
                    <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="Diashow" Icon="{ui:SymbolIcon Play24}" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="StorySlideshow"
                               Visibility="{Binding HasSlideshow, Converter={StaticResource BoolToVis}}"
                               Command="{Binding StartSlideshowCommand}" />
                    <ScrollViewer Margin="10,0,10,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center"
                                  PreviewMouseWheel="OnChipsMouseWheel" Focusable="False">
                        <ItemsControl ItemsSource="{Binding DayChips}" Focusable="False" AutomationProperties.AutomationId="StoryDayChips">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:StoryDayChip}">
                                    <local:StorySelectButton Style="{StaticResource StoryChipButton}" IsChecked="{Binding IsSelected, Mode=OneWay}" Content="{Binding Label}" Margin="0,0,4,0"
                                            AutomationProperties.Name="{Binding Label}"
                                            Command="{Binding Owner.JumpToDayCommand}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" VerticalAlignment="Top" Margin="0,140,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</UserControl>
