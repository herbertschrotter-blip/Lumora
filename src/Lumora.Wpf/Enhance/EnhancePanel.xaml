<UserControl x:Class="Lumora.Enhance.EnhancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Lumora.Enhance"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:EnhancePanelViewModel, IsDesignTimeCreatable=False}"
             Width="340"
             Focusable="False"
             IsTabStop="False">
    <!--
        Leiste „Verbessern“ in der Lightbox (Mockup 13, ADR-0071): Werkzeuge mit Modell-Zustand („bereit“ / „Modell fehlt“ mit
        „Laden…“ / „Quelle folgt“), Optionen des gewählten Werkzeugs, Vorschau berechnen → Vorher/Nachher auf der Bühne →
        „Als neue Datei speichern“ oder „Verwerfen“. Lightbox-Farben (immer dunkel). DataContext = EnhancePanelViewModel.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Lightbox/LightboxResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="EnhanceToolBrush" Color="#26262C" />
            <SolidColorBrush x:Key="EnhanceToolSelectedBrush" Color="#2C2C3A" />
            <SolidColorBrush x:Key="EnhanceAccentBrush" Color="#818CF8" />
            <SolidColorBrush x:Key="EnhanceAccentTextBrush" Color="#A5B0FF" />
            <SolidColorBrush x:Key="EnhanceOkBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="EnhanceOkBackBrush" Color="#246CCB5F" />
            <SolidColorBrush x:Key="EnhanceNeedBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="EnhanceNeedBackBrush" Color="#24FCE100" />
            <Style x:Key="EnhanceLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource LightboxTextSecondaryBrush}" />
                <Setter Property="Margin" Value="0,6,0,2" />
            </Style>
            <Style x:Key="EnhanceSmallButton" TargetType="Button" BasedOn="{StaticResource LightboxOverlayButton}">
                <Setter Property="Background" Value="{DynamicResource LightboxChipBrush}" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Margin" Value="0,0,6,6" />
            </Style>
            <Style x:Key="EnhanceCheck" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource LightboxTextBrush}" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Margin" Value="0,4,0,4" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource LightboxPanelBrush}"
            BorderBrush="{DynamicResource LightboxPanelBorderBrush}"
            BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="16,14,16,8">
                <StackPanel>
                    <!-- Kopf -->
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LightboxOverlayButton}" MinWidth="30" MinHeight="30" Padding="4"
                                Click="OnCloseClick" ToolTip="Leiste schließen" AutomationProperties.Name="Verbessern schließen">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Sparkle24" FontSize="18" Foreground="{DynamicResource EnhanceAccentTextBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Verbessern" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource LightboxTextBrush}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Margin="0,6,0,10" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                               Foreground="{DynamicResource LightboxTextSecondaryBrush}"
                               Text="Das Original bleibt unverändert. Vorschau zuerst, gespeichert wird erst auf Ihren Klick." />

                    <TextBlock Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource LightboxTextSecondaryBrush}"
                               Text="Videos und Archive lassen sich nicht verbessern."
                               Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <!-- Werkzeuge -->
                    <ItemsControl ItemsSource="{Binding Tools}" Focusable="False" AutomationProperties.AutomationId="EnhanceTools">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:EnhanceToolItem}">
                                <Border x:Name="Card" Margin="0,0,0,6" CornerRadius="6" BorderThickness="1" Padding="10,8"
                                        Background="{DynamicResource EnhanceToolBrush}" BorderBrush="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Ganze Karte schaltet das Werkzeug um. Eigene, leere Vorlage und Stretch: der WPF-UI-Stil
                                             richtet Knöpfe links aus, der leere Knopf saß sonst winzig beim Symbol (bis 0.5.2). -->
                                        <Button Grid.ColumnSpan="3" Margin="-10,-8" Focusable="False" Cursor="Hand"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                Command="{Binding Owner.ToggleToolCommand}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding AutomationName}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Symbol}" FontSize="18" IsHitTestVisible="False"
                                                       Foreground="{DynamicResource EnhanceAccentTextBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1" IsHitTestVisible="False" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource LightboxTextBrush}" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource LightboxTextSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                            <Border x:Name="Chip" CornerRadius="8" Padding="7,1" HorizontalAlignment="Right" IsHitTestVisible="False"
                                                    Background="{DynamicResource EnhanceNeedBackBrush}">
                                                <TextBlock x:Name="ChipText" Text="{Binding StateText}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource EnhanceNeedBrush}" />
                                            </Border>
                                            <Button Style="{StaticResource EnhanceSmallButton}" Margin="0,6,0,0" HorizontalAlignment="Right"
                                                    Command="{Binding Owner.LoadModelCommand}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CanLoad, Converter={StaticResource BoolToVis}}"
                                                    IsEnabled="{Binding IsLoading, Converter={x:Static local:InverseBoolConverter.Instance}}"
                                                    AutomationProperties.Name="Modell laden">
                                                <TextBlock Text="Laden…" FontSize="11" Foreground="{DynamicResource LightboxTextBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource EnhanceAccentBrush}" />
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource EnhanceToolSelectedBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsReady}" Value="True">
                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource EnhanceOkBackBrush}" />
                                        <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource EnhanceOkBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Optionen: Hochskalieren -->
                    <StackPanel Visibility="{Binding Tools[1].IsSelected, Converter={StaticResource BoolToVis}}" Margin="0,4,0,6">
                        <TextBlock Style="{StaticResource EnhanceLabel}" Text="Hochskalieren" />
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Content="2×" MinWidth="48" Margin="0,0,6,0" Focusable="False"
                                          IsChecked="{Binding IsUpscale4, Mode=OneWay, Converter={x:Static local:InverseBoolConverter.Instance}}"
                                          Command="{Binding SetUpscaleFactorCommand}" CommandParameter="2" AutomationProperties.Name="2-fach" />
                            <ToggleButton Content="4×" MinWidth="48" Focusable="False"
                                          IsChecked="{Binding IsUpscale4, Mode=OneWay}"
                                          Command="{Binding SetUpscaleFactorCommand}" CommandParameter="4" AutomationProperties.Name="4-fach" />
                        </StackPanel>
                        <!-- Modell (0.5.7/0.5.11): je Foto wählbar, Zustand und „Laden…“ des gewählten darunter -->
                        <TextBlock Style="{StaticResource EnhanceLabel}" Text="Modell" />
                        <ItemsControl ItemsSource="{Binding UpscaleModels}" Focusable="False" AutomationProperties.Name="Modelle zum Hochskalieren">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:EnhanceToolItem}">
                                    <ToggleButton Content="{Binding Title}" MinWidth="64" Margin="0,0,6,6" Focusable="False"
                                                  ToolTip="{Binding Subtitle}"
                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Command="{Binding Owner.SetUpscaleModelCommand}" CommandParameter="{Binding}"
                                                  AutomationProperties.Name="{Binding Title, StringFormat='Modell {0}'}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource LightboxTextSecondaryBrush}">
                            <Run Text="{Binding ChosenUpscaleModel.Subtitle, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ChosenUpscaleModel.StateText, Mode=OneWay}" />
                        </TextBlock>
                        <Button Style="{StaticResource EnhanceSmallButton}" Margin="0,6,0,0" HorizontalAlignment="Left"
                                Command="{Binding LoadModelCommand}" CommandParameter="{Binding ChosenUpscaleModel}"
                                Visibility="{Binding ChosenUpscaleModel.CanLoad, Converter={StaticResource BoolToVis}}"
                                IsEnabled="{Binding ChosenUpscaleModel.IsLoading, Converter={x:Static local:InverseBoolConverter.Instance}}"
                                AutomationProperties.Name="{Binding ChosenUpscaleModel.LoadText}">
                            <TextBlock Text="{Binding ChosenUpscaleModel.LoadText}" FontSize="11" Foreground="{DynamicResource LightboxTextBrush}" />
                        </Button>
                    </StackPanel>

                    <!-- Natürlichkeit beim Hochskalieren (0.5.6): Original zurückmischen und feine Körnung gegen „Plastikhaut“ -->
                    <StackPanel Visibility="{Binding ShowNaturalness, Converter={StaticResource BoolToVis}}" Margin="0,4,0,6">
                        <TextBlock Style="{StaticResource EnhanceLabel}" Text="{Binding Naturalness, StringFormat='Natürlichkeit {0:P0}'}"
                                   ToolTip="Mischt etwas vom Original zurück — Haut und Strukturen wirken weniger glatt und künstlich" />
                        <Slider Style="{StaticResource LightboxSlider}" Minimum="0" Maximum="0.8" Value="{Binding Naturalness}"
                                AutomationProperties.Name="Natürlichkeit" />
                        <TextBlock Style="{StaticResource EnhanceLabel}" Text="{Binding Grain, StringFormat='Körnung {0:P0}'}"
                                   ToolTip="Feines Korn vor allem in mittleren Helligkeiten (Haut), kaum in Tiefen und Lichtern" />
                        <Slider Style="{StaticResource LightboxSlider}" Minimum="0" Maximum="1" Value="{Binding Grain}"
                                AutomationProperties.Name="Körnung" />
                    </StackPanel>

                    <!-- Optionen: Gesichter -->
                    <StackPanel Visibility="{Binding Tools[2].IsSelected, Converter={StaticResource BoolToVis}}" Margin="0,4,0,6">
                        <TextBlock Style="{StaticResource EnhanceLabel}" Text="{Binding FaceStrength, StringFormat='Stärke {0:P0}'}" />
                        <Slider Style="{StaticResource LightboxSlider}" Minimum="0.1" Maximum="1" Value="{Binding FaceStrength}" AutomationProperties.Name="Stärke" />
                    </StackPanel>

                    <!-- Optionen: Entfernen -->
                    <StackPanel Visibility="{Binding Tools[4].IsSelected, Converter={StaticResource BoolToVis}}" Margin="0,4,0,6">
                        <TextBlock Style="{StaticResource EnhanceLabel}" Text="Pinselgröße" />
                        <Slider Style="{StaticResource LightboxSlider}" Minimum="0.005" Maximum="0.1" Value="{Binding BrushSize}" AutomationProperties.Name="Pinselgröße" />
                        <CheckBox Style="{StaticResource EnhanceCheck}" IsChecked="{Binding Scratches}" Content="Kratzer und Flecken automatisch" />
                        <TextBlock Text="{Binding BrushSummary}" FontSize="11" Foreground="{DynamicResource LightboxTextSecondaryBrush}" Margin="0,2,0,6" />
                        <WrapPanel>
                            <Button Style="{StaticResource EnhanceSmallButton}" Command="{Binding UndoStrokeCommand}" AutomationProperties.Name="Strich zurück">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="13" Margin="0,0,4,0" />
                                    <TextBlock Text="Strich zurück" FontSize="11" Foreground="{DynamicResource LightboxTextBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource EnhanceSmallButton}" Command="{Binding ClearStrokesCommand}" AutomationProperties.Name="Auswahl leeren">
                                <TextBlock Text="Auswahl leeren" FontSize="11" Foreground="{DynamicResource LightboxTextBrush}" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Optionen: Zuschneiden, drehen, Licht -->
                    <StackPanel Visibility="{Binding Tools[5].IsSelected, Converter={StaticResource BoolToVis}}" Margin="0,4,0,6">
                        <TextBlock Style="{StaticResource EnhanceLabel}" Text="Drehen" />
                        <WrapPanel>
                            <Button Style="{StaticResource EnhanceSmallButton}" Command="{Binding RotateLeftCommand}" ToolTip="Nach links drehen" AutomationProperties.Name="Nach links drehen">
                                <ui:SymbolIcon Symbol="ArrowRotateCounterclockwise24" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource EnhanceSmallButton}" Command="{Binding RotateRightCommand}" ToolTip="Nach rechts drehen" AutomationProperties.Name="Nach rechts drehen">
                                <ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="14" />
                            </Button>
                            <TextBlock Text="{Binding RotationText}" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,6"
                                       Foreground="{DynamicResource LightboxTextSecondaryBrush}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource EnhanceLabel}" Text="Zuschnitt (mittig)" />
                        <ComboBox ItemsSource="{Binding CropChoices}" SelectedItem="{Binding CropPreset}" Focusable="False" AutomationProperties.Name="Zuschnitt" />
                        <TextBlock Style="{StaticResource EnhanceLabel}" Text="{Binding Brightness, StringFormat='Helligkeit {0:+0.00;-0.00;0}'}" />
                        <Slider Style="{StaticResource LightboxSlider}" Minimum="-1" Maximum="1" Value="{Binding Brightness}" AutomationProperties.Name="Helligkeit" />
                        <TextBlock Style="{StaticResource EnhanceLabel}" Text="{Binding Contrast, StringFormat='Kontrast {0:+0.00;-0.00;0}'}" />
                        <Slider Style="{StaticResource LightboxSlider}" Minimum="-1" Maximum="1" Value="{Binding Contrast}" AutomationProperties.Name="Kontrast" />
                        <Button Style="{StaticResource EnhanceSmallButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding ResetAdjustCommand}" AutomationProperties.Name="Zurücksetzen">
                            <TextBlock Text="Zurücksetzen" FontSize="11" Foreground="{DynamicResource LightboxTextBrush}" />
                        </Button>
                    </StackPanel>

                    <!-- Fortschritt -->
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource EnhanceSmallButton}" Margin="6,0,0,0" Command="{Binding CancelCommand}" AutomationProperties.Name="Abbrechen">
                                <TextBlock Text="Abbrechen" FontSize="11" Foreground="{DynamicResource LightboxTextBrush}" />
                            </Button>
                            <TextBlock Text="{Binding ProgressText}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource LightboxTextSecondaryBrush}" />
                        </DockPanel>
                        <ProgressBar Margin="0,6,0,0" Height="4" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding PreviewInfo}"
                               Foreground="{DynamicResource LightboxTextSecondaryBrush}"
                               Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}" />
                    <TextBlock x:Name="MessageText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Message}"
                               AutomationProperties.AutomationId="EnhanceMessage"
                               Visibility="{Binding Message, Converter={StaticResource StringToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource LightboxTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource LightboxErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="14" Foreground="{DynamicResource LightboxTextSecondaryBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding GpuText}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource LightboxTextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Speichern -->
            <Border Grid.Row="1" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Padding="16,10,16,14">
                <StackPanel>
                    <TextBlock Text="Speichern als neue Datei daneben:" FontSize="12" Foreground="{DynamicResource LightboxTextSecondaryBrush}" />
                    <Border Margin="0,4,0,8" CornerRadius="4" Padding="8,5" Background="{DynamicResource EnhanceToolBrush}">
                        <TextBlock Text="{Binding TargetName, TargetNullValue='—'}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource LightboxTextBrush}"
                                   AutomationProperties.AutomationId="EnhanceTargetName" />
                    </Border>
                    <Button Style="{StaticResource EnhanceSmallButton}" Margin="0,0,0,6" HorizontalAlignment="Stretch" Padding="10,7"
                            Background="{DynamicResource EnhanceAccentBrush}" Command="{Binding CalculateCommand}"
                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                            AutomationProperties.Name="Vorschau berechnen">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Sparkle24" FontSize="14" Foreground="#111111" Margin="0,0,6,0" />
                            <TextBlock Text="Vorschau berechnen" FontSize="13" Foreground="#111111" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource EnhanceSmallButton}" Margin="0,0,0,6" HorizontalAlignment="Stretch" Padding="10,7"
                            Background="{DynamicResource EnhanceAccentBrush}" Command="{Binding SaveCommand}"
                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Als neue Datei speichern">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save24" FontSize="14" Foreground="#111111" Margin="0,0,6,0" />
                            <TextBlock Text="Als neue Datei speichern" FontSize="13" Foreground="#111111" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource EnhanceSmallButton}" Margin="0" HorizontalAlignment="Stretch" Padding="10,7"
                            Command="{Binding DiscardCommand}"
                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Verwerfen">
                        <TextBlock Text="Verwerfen" FontSize="13" Foreground="{DynamicResource LightboxTextBrush}" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
