<dialogs:AppFluentWindow x:Class="Lumora.Lightbox.LightboxWindow"
                 xmlns:dialogs="clr-namespace:Lumora.Shell.Dialogs"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
                 xmlns:local="clr-namespace:Lumora.Lightbox"
                 xmlns:controls="clr-namespace:Lumora.Lightbox.Controls"
                 xmlns:tags="clr-namespace:Lumora.Gallery.Tags"
                 xmlns:branding="clr-namespace:Lumora.Shell.Branding"
                 xmlns:enhance="clr-namespace:Lumora.Enhance"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=local:LightboxViewModel}"
                 Title="{Binding Title, Converter={x:Static branding:LumoraWindowTitleConverter.Instance}}"
                 Width="1280"
                 Height="800"
                 MinWidth="640"
                 MinHeight="400"
                 Background="{DynamicResource LightboxBackgroundBrush}"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner">

    <dialogs:AppFluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LightboxResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dialogs:AppFluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Minimale Titelleiste: Dateiname links, Maße/Größe/Datum + Zähler rechts -->
        <ui:TitleBar x:Name="TitleBar"
                     Grid.Row="0"
                     Title="{Binding Title}"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     CanMaximize="True">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <!-- Tags/Kategorien in der Titelleiste nur, wenn die Leiste unten abgeschaltet ist (Mockup 16) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding ShowTitleMarks, Converter={StaticResource BoolToVis}}">
                    <!-- Tags der Datei (Strg+T bearbeitet, ADR-0021) -->
                    <tags:TagChipsControl Tags="{Binding CurrentTags}"
                                          Compact="False"
                                          VerticalAlignment="Center"
                                          Margin="0,2,12,0"
                                          ToolTip="{Binding CurrentTagsText}" />
                    <!-- Gesetzte Kategorie-Werte (Strg+K weist zu, ADR-0027) -->
                    <Border CornerRadius="10"
                            Padding="10,2"
                            Margin="0,0,12,0"
                            MaxWidth="320"
                            Background="{DynamicResource LightboxChipBrush}"
                            VerticalAlignment="Center"
                            ToolTip="{Binding CurrentCategoriesToolTip}"
                            Visibility="{Binding HasCurrentCategoryValues, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding CurrentCategoriesText}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource LightboxTextBrush}" />
                    </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Foreground="{DynamicResource LightboxTextSecondaryBrush}" />
                    <Border CornerRadius="10"
                            Padding="10,2"
                            Background="{DynamicResource LightboxChipBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding CounterText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource LightboxTextBrush}" />
                    </Border>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Bühne: Bild (ZoomPan) oder Video (LibVLC) + Overlays -->
            <Grid x:Name="Stage" Grid.Column="0" Background="{DynamicResource LightboxBackgroundBrush}">

                <controls:ZoomPanControl x:Name="ZoomPan"
                                         Source="{Binding ImageSource}"
                                         ZoomPercent="{Binding ZoomPercent, Mode=OneWayToSource}"
                                         IsFit="{Binding IsZoomFit, Mode=OneWayToSource}"
                                         Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                    <!-- Gesichtsrahmen (Taste F, 0.2.38): wandern mit Zoom/Schwenk, Klick öffnet das Benennen-Menü -->
                    <controls:ZoomPanControl.Overlay>
                        <controls:FaceBoxesLayer x:Name="FaceBoxes"
                                                 Controller="{Binding Faces}"
                                                 Visibility="{Binding Faces.ShowBoxes, Converter={StaticResource BoolToVis}}" />
                    </controls:ZoomPanControl.Overlay>
                </controls:ZoomPanControl>

                <!-- VideoView = HwndHost. Overlays darüber MÜSSEN im Content liegen (Airspace). -->
                <vlc:VideoView x:Name="VideoView"
                               MediaPlayer="{Binding Player}"
                               Background="Black"
                               Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                    <local:LightboxOverlay x:Name="VideoOverlay" IsSurfaceInteractive="True" />
                </vlc:VideoView>

                <!-- Archiv-Inhaltsansicht (ADR-0022) statt Bild/Video -->
                <local:ArchiveContentView Visibility="{Binding IsArchive, Converter={StaticResource BoolToVis}}" />

                <!-- Foto verbessern (ADR-0071): Vorher/Nachher bzw. Pinsel über dem Bild, nur bei offener Leiste -->
                <enhance:EnhanceStageOverlay x:Name="EnhanceStage"
                                             AutomationProperties.AutomationId="EnhanceStage"
                                             BeforeSource="{Binding ImageSource}"
                                             AfterSource="{Binding Enhance.AfterImage, FallbackValue={x:Null}}"
                                             Position="{Binding Enhance.ComparePosition, FallbackValue=0.5}"
                                             IsBrushMode="{Binding Enhance.IsBrushMode, FallbackValue=False}"
                                             Dots="{Binding Enhance.BrushDots, FallbackValue={x:Null}}"
                                             BrushSize="{Binding Enhance.BrushSize, FallbackValue=0.03}"
                                             BrushTarget="{Binding Enhance, FallbackValue={x:Null}}"
                                             Visibility="{Binding Enhance.ShowsOverlay, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />

                <!-- Overlay für den Bild-Modus (direkt im Fenster, durchlässig für Rad/Drag) -->
                <local:LightboxOverlay x:Name="ImageOverlay"
                                       IsSurfaceInteractive="False"
                                       Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
            </Grid>

            <!-- Info-Panel rechts (I) -->
            <Border x:Name="InfoPanel"
                    Grid.Column="1"
                    Width="300"
                    Background="{DynamicResource LightboxPanelBrush}"
                    BorderBrush="{DynamicResource LightboxPanelBorderBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding IsInfoVisible, Converter={StaticResource BoolToVis}}">
                <Border.Resources>
                    <Style x:Key="InfoHeader" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{DynamicResource LightboxTextSecondaryBrush}" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                    <DataTemplate x:Key="InfoRowTemplate" DataType="{x:Type local:LightboxInfoRow}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Label}"
                                       FontSize="12"
                                       Foreground="{DynamicResource LightboxTextSecondaryBrush}"
                                       VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Value}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource LightboxTextBrush}"
                                       ToolTip="{Binding Value}" />
                        </Grid>
                    </DataTemplate>
                </Border.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,16,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource InfoHeader}" Text="DATEI" />
                        <ItemsControl ItemsSource="{Binding FileInfoRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />

                        <!-- „Position geschätzt“ mit Begründung und Vorschlag (ADR-0062, Mockup 10) -->
                        <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="8" BorderThickness="1"
                                AutomationProperties.AutomationId="LightboxGeoHint"
                                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                Visibility="{Binding HasGeoHint, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Warning16" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    <TextBlock Text="{Binding GeoHintTitle}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" Text="{Binding GeoHintText}" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                                           Foreground="{DynamicResource LightboxTextBrush}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource LightboxOverlayButton}" Padding="10,4" MinHeight="28" Margin="0,0,6,6"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            AutomationProperties.Name="Vorschlag übernehmen"
                                            Visibility="{Binding HasGeoHintSuggestion, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding ApplyGeoHintCommand}">
                                        <TextBlock Text="Vorschlag übernehmen" FontSize="12" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Button>
                                    <Button Style="{StaticResource LightboxOverlayButton}" Padding="10,4" MinHeight="28" Margin="0,0,6,6"
                                            Background="{DynamicResource LightboxChipBrush}"
                                            AutomationProperties.Name="Auf der Karte zeigen"
                                            Command="{Binding ShowGeoHintOnMapCommand}">
                                        <TextBlock Text="Auf der Karte zeigen" FontSize="12" Foreground="{DynamicResource LightboxTextBrush}" />
                                    </Button>
                                    <Button Style="{StaticResource LightboxOverlayButton}" Padding="10,4" MinHeight="28" Margin="0,0,6,6"
                                            Background="{DynamicResource LightboxChipBrush}"
                                            AutomationProperties.Name="Ort setzen"
                                            Visibility="{Binding CanSetPlaceFromHint, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding SetPlaceFromHintCommand}">
                                        <TextBlock Text="Ort setzen…" FontSize="12" Foreground="{DynamicResource LightboxTextBrush}" />
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource InfoHeader}"
                                   Text="{Binding MediaInfoHeader}"
                                   Margin="0,14,0,8" />
                        <ItemsControl ItemsSource="{Binding MediaInfoRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />

                        <!-- Motive (ADR-0052): erkannte Begriffe, wahrscheinlichste zuerst -->
                        <StackPanel Visibility="{Binding HasCurrentMotifs, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource InfoHeader}" Text="MOTIVE" Margin="0,14,0,8" />
                            <TextBlock Text="{Binding CurrentMotifsText}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="LightboxMotifs"
                                       Foreground="{DynamicResource LightboxTextBrush}" />
                        </StackPanel>

                        <!-- Kategorien der Datei (ADR-0027): alle Kategorien, „—“ ohne Wert; Zuweisen öffnet den Strg+K-Dialog -->
                        <StackPanel Visibility="{Binding HasCategories, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource InfoHeader}" Text="KATEGORIEN" Margin="0,14,0,8" />
                            <ItemsControl ItemsSource="{Binding CategoryRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />
                            <Button Style="{StaticResource LightboxOverlayButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,2,0,0"
                                    Padding="10,4"
                                    MinHeight="28"
                                    Background="{DynamicResource LightboxChipBrush}"
                                    Command="{Binding EditCategoriesCommand}"
                                    ToolTip="Kategorie-Werte zuweisen (Strg+K)"
                                    AutomationProperties.Name="Kategorien zuweisen">
                                <TextBlock Text="Zuweisen… (Strg+K)" FontSize="12" Foreground="{DynamicResource LightboxTextBrush}" />
                            </Button>
                        </StackPanel>

                        <TextBlock Style="{StaticResource InfoHeader}" Text="TASTEN" Margin="0,18,0,8" />
                        <TextBlock FontSize="11"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource LightboxTextSecondaryBrush}"
                                   Text="← → Blättern · Pos1/Ende Anfang/Ende · Bild↑/↓ ±10&#x0a;+ − Zoom · 1 = 100 % · 0 = Einpassen · Doppelklick Fit ↔ 100 %&#x0a;Leertaste Play/Pause · M Stumm&#x0a;Strg+D Favorit · Strg+1…5 Bewertung · Strg+0 löscht&#x0a;Strg+T Tags · Strg+K Kategorien&#x0a;F Gesichter · I Info · S Diashow ab hier · F11 Vollbild · Entf Papierkorb · Esc Schließen" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Leiste „Verbessern“ rechts (E, ADR-0071, Mockup 13) -->
            <enhance:EnhancePanel x:Name="EnhancePanelView"
                                  Grid.Column="2"
                                  DataContext="{Binding Enhance}"
                                  Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
        </Grid>

        <!-- Leiste unten: Tags, Kategorien, „+ Tag / Kategorie“ (Mockup 16); aus im Vollbild und per Schalter -->
        <local:LightboxMarksBar x:Name="MarksBar"
                                Grid.Row="2"
                                Visibility="{Binding ShowMarksBar, Converter={StaticResource BoolToVis}}" />
    </Grid>
</dialogs:AppFluentWindow>
