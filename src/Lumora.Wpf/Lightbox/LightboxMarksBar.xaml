<UserControl x:Class="Lumora.Lightbox.LightboxMarksBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Lumora.Lightbox"
             xmlns:tags="clr-namespace:Lumora.Gallery.Tags"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:LightboxViewModel}"
             Focusable="False"
             IsTabStop="False">
    <!--
        Leiste unten in der Lightbox (Mockup 16): Tag-Symbol + Tag-Chips (Farbpunkt + Name), Trenner, Kategorie-Symbol +
        gesetzte Kategorien („Kategorie: Wert“) und „+ Tag / Kategorie“ — öffnet ein Menü mit den vorhandenen Dialogen
        (Strg+T Tags, Strg+K Kategorien). Lightbox-Farben (immer dunkel, LightboxResources.xaml). DataContext = LightboxViewModel.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LightboxResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <tags:TagBrushConverter x:Key="MarksTagBrush" />
            <SolidColorBrush x:Key="LightboxMarksSeparatorBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="LightboxMarksAddBrush" Color="#B8BCFF" />
            <Style x:Key="MarksChip" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource LightboxChipBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Margin" Value="0,2,6,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource LightboxChromeBrush}"
            BorderBrush="{DynamicResource LightboxPanelBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,6"
            MinHeight="44">
        <WrapPanel VerticalAlignment="Center">
            <!-- Tags -->
            <StackPanel x:Name="TagsPart"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasCurrentTags, Converter={StaticResource BoolToVis}}">
                <ui:SymbolIcon Symbol="Tag24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource LightboxTextSecondaryBrush}" />
                <ItemsControl x:Name="TagChips" ItemsSource="{Binding CurrentTags}" Focusable="False" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MarksChip}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center"
                                             Fill="{Binding Color, Converter={StaticResource MarksTagBrush}}" />
                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource LightboxTextBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Trenner nur, wenn beides da ist -->
            <Border Width="1" Height="20" Margin="6,0,12,0" VerticalAlignment="Center"
                    Background="{DynamicResource LightboxMarksSeparatorBrush}"
                    Visibility="{Binding ShowMarksSeparator, Converter={StaticResource BoolToVis}}" />

            <!-- Kategorien -->
            <StackPanel x:Name="CategoriesPart"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasCurrentCategoryValues, Converter={StaticResource BoolToVis}}">
                <ui:SymbolIcon Symbol="Group24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource LightboxTextSecondaryBrush}" />
                <ItemsControl x:Name="CategoryChips" ItemsSource="{Binding CurrentCategoryLabels}" Focusable="False" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MarksChip}">
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource LightboxTextBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- „+ Tag / Kategorie“: Menü mit den vorhandenen Zuordnungs-Dialogen -->
            <Button x:Name="AddButton"
                    Style="{StaticResource LightboxOverlayButton}"
                    Padding="8,4"
                    MinHeight="28"
                    Margin="4,0,0,0"
                    ToolTip="Tags (Strg+T) oder Kategorien (Strg+K) zuweisen"
                    AutomationProperties.Name="Tag oder Kategorie zuweisen"
                    Click="OnAddClick">
                <TextBlock Text="+ Tag / Kategorie" FontSize="12" Foreground="{DynamicResource LightboxMarksAddBrush}" />
                <Button.ContextMenu>
                    <ContextMenu x:Name="AddMenu">
                        <MenuItem Header="Tags bearbeiten…"
                                  InputGestureText="Strg+T"
                                  Icon="{ui:SymbolIcon Tag24}"
                                  Command="{Binding EditTagsCommand}" />
                        <MenuItem Header="Kategorien zuweisen…"
                                  InputGestureText="Strg+K"
                                  Icon="{ui:SymbolIcon Group24}"
                                  Command="{Binding EditCategoriesCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </WrapPanel>
    </Border>
</UserControl>
