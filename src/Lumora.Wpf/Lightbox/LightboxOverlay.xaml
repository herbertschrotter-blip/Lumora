<UserControl x:Class="Lumora.Lightbox.LightboxOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Lumora.Lightbox"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:LightboxViewModel}"
             d:DesignWidth="1000"
             d:DesignHeight="600"
             Focusable="False"
             IsTabStop="False">

    <!--
        Overlay über dem Bild-/Videobereich: Toolbar oben (Auto-Hide), Navigationspfeile,
        Transportleiste (Video), Status/Fehler/Ladeanzeige. Wird zweimal instanziiert:
        im Bild-Modus direkt im Fenster, im Video-Modus als VideoView.Content, weil LibVLCSharp
        den Content in einem transparenten Vordergrundfenster über dem HwndHost rendert (Airspace).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LightboxResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root">

        <!-- Fläche für Mausbewegung/Doppelklick im Video-Modus; im Bild-Modus nicht hit-testbar (Rad/Drag → ZoomPan) -->
        <Border x:Name="Surface"
                Background="#01000000"
                IsHitTestVisible="{Binding IsSurfaceInteractive, RelativeSource={RelativeSource AncestorType=local:LightboxOverlay}}" />

        <!-- Ladeanzeige / Fehler-Platzhalter -->
        <ui:ProgressRing IsIndeterminate="True"
                         Width="40"
                         Height="40"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="560"
                    IsHitTestVisible="False"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
            <ui:SymbolIcon Symbol="ImageOff24"
                           FontSize="56"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource LightboxTextSecondaryBrush}" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Margin="0,12,0,0"
                       FontSize="13"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource LightboxErrorBrush}" />
            <TextBlock Text="{Binding CurrentItem.Path}"
                       Margin="0,6,0,0"
                       FontSize="11"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource LightboxTextSecondaryBrush}" />
        </StackPanel>

        <!-- Navigationspfeile -->
        <Button Style="{StaticResource LightboxNavButton}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="20,0,0,0"
                Command="{Binding PreviousCommand}"
                ToolTip="Vorheriges (←)"
                Visibility="{Binding IsChromeVisible, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="22" />
        </Button>
        <Button Style="{StaticResource LightboxNavButton}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,20,0"
                Command="{Binding NextCommand}"
                ToolTip="Nächstes (→)"
                Visibility="{Binding IsChromeVisible, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon Symbol="ChevronRight24" FontSize="22" />
        </Button>

        <!-- Toolbar oben -->
        <Border x:Name="Toolbar"
                VerticalAlignment="Top"
                Padding="12,6"
                Background="{DynamicResource LightboxChromeBrush}"
                Visibility="{Binding IsChromeVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Zoom (nur Bilder) -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource LightboxOverlayButton}"
                            Command="{Binding ZoomOutCommand}"
                            ToolTip="Verkleinern (−)">
                        <ui:SymbolIcon Symbol="ZoomOut24" FontSize="18" />
                    </Button>
                    <TextBlock Style="{StaticResource LightboxOverlayText}"
                               Text="{Binding ZoomText}"
                               MinWidth="88"
                               TextAlignment="Center" />
                    <Button Style="{StaticResource LightboxOverlayButton}"
                            Command="{Binding ZoomInCommand}"
                            ToolTip="Vergrößern (+)">
                        <ui:SymbolIcon Symbol="ZoomIn24" FontSize="18" />
                    </Button>
                    <Button Style="{StaticResource LightboxOverlayButton}"
                            Command="{Binding ZoomFitCommand}"
                            ToolTip="Einpassen (0)">
                        <ui:SymbolIcon Symbol="ZoomFit24" FontSize="18" />
                    </Button>
                    <Button Style="{StaticResource LightboxOverlayButton}"
                            Command="{Binding ZoomActualCommand}"
                            ToolTip="100 % (1) · Doppelklick wechselt Fit ↔ 100 %">
                        <ui:SymbolIcon Symbol="RatioOneToOne24" FontSize="18" />
                    </Button>
                </StackPanel>

                <!-- Aktionen rechts -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Diashow ab hier (ADR-0059) -->
                    <Button Style="{StaticResource LightboxOverlayButton}"
                            Command="{Binding StartSlideshowCommand}"
                            ToolTip="Diashow ab hier (S)"
                            AutomationProperties.Name="Diashow ab hier"
                            Visibility="{Binding HasSlideshow, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="Play24" FontSize="18" />
                    </Button>
                    <Button Style="{StaticResource LightboxOverlayButton}"
                            Command="{Binding ToggleFavoriteCommand}"
                            ToolTip="Favorit (Strg+D)">
                        <ui:SymbolIcon Symbol="Heart24"
                                       FontSize="18"
                                       Filled="{Binding CurrentItem.IsFavorite, FallbackValue=False}">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource LightboxTextBrush}" />
                                    <Style.Triggers>
                                        <Trigger Property="Filled" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource LightboxFavoriteBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Button>

                    <!-- Bewertung 1–5 (Strg+1…5, Strg+0 löscht) -->
                    <StackPanel Orientation="Horizontal" Margin="4,0,8,0">
                        <StackPanel.Resources>
                            <Style x:Key="StarIcon" TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="Star24" />
                                <Setter Property="FontSize" Value="16" />
                                <Setter Property="Foreground" Value="{DynamicResource LightboxTextSecondaryBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="Filled" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource LightboxStarBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="StarButton" TargetType="Button" BasedOn="{StaticResource LightboxOverlayButton}">
                                <Setter Property="Padding" Value="3,6" />
                                <Setter Property="MinWidth" Value="24" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Command" Value="{Binding SetRatingCommand}" />
                            </Style>
                        </StackPanel.Resources>
                        <Button Style="{StaticResource StarButton}" CommandParameter="1" ToolTip="1 Stern (Strg+1)">
                            <ui:SymbolIcon Style="{StaticResource StarIcon}" Filled="{Binding CurrentItem.Rating, Converter={StaticResource RatingAtLeast}, ConverterParameter=1, FallbackValue=False}" />
                        </Button>
                        <Button Style="{StaticResource StarButton}" CommandParameter="2" ToolTip="2 Sterne (Strg+2)">
                            <ui:SymbolIcon Style="{StaticResource StarIcon}" Filled="{Binding CurrentItem.Rating, Converter={StaticResource RatingAtLeast}, ConverterParameter=2, FallbackValue=False}" />
                        </Button>
                        <Button Style="{StaticResource StarButton}" CommandParameter="3" ToolTip="3 Sterne (Strg+3)">
                            <ui:SymbolIcon Style="{StaticResource StarIcon}" Filled="{Binding CurrentItem.Rating, Converter={StaticResource RatingAtLeast}, ConverterParameter=3, FallbackValue=False}" />
                        </Button>
                        <Button Style="{StaticResource StarButton}" CommandParameter="4" ToolTip="4 Sterne (Strg+4)">
                            <ui:SymbolIcon Style="{StaticResource StarIcon}" Filled="{Binding CurrentItem.Rating, Converter={StaticResource RatingAtLeast}, ConverterParameter=4, FallbackValue=False}" />
                        </Button>
                        <Button Style="{StaticResource StarButton}" CommandParameter="5" ToolTip="5 Sterne (Strg+5)">
                            <ui:SymbolIcon Style="{StaticResource StarIcon}" Filled="{Binding CurrentItem.Rating, Converter={StaticResource RatingAtLeast}, ConverterParameter=5, FallbackValue=False}" />
                        </Button>
                    </StackPanel>

                    <!-- Gesichtsrahmen (0.2.38) -->
                    <Button Style="{StaticResource LightboxOverlayButton}"
                            Command="{Binding ToggleFacesCommand}"
                            ToolTip="Gesichter (F)"
                            AutomationProperties.Name="Gesichter anzeigen"
                            Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="PersonSquare24" FontSize="18" Filled="{Binding Faces.IsVisible}" />
                    </Button>
                    <!-- Foto verbessern (E, ADR-0071) -->
                    <Button Style="{StaticResource LightboxOverlayButton}"
                            Command="{Binding ToggleEnhanceCommand}"
                            ToolTip="Verbessern (E) — Original bleibt unverändert"
                            AutomationProperties.Name="Verbessern"
                            Visibility="{Binding HasEnhance, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="Sparkle24" FontSize="18" Filled="{Binding Enhance.IsOpen, FallbackValue=False}" />
                    </Button>
                    <Button Style="{StaticResource LightboxOverlayButton}"
                            Command="{Binding ToggleInfoCommand}"
                            ToolTip="Info-Panel (I)">
                        <ui:SymbolIcon Symbol="Info24" FontSize="18" Filled="{Binding IsInfoVisible}" />
                    </Button>
                    <Button Style="{StaticResource LightboxOverlayButton}"
                            Command="{Binding ShowInExplorerCommand}"
                            ToolTip="Im Explorer anzeigen">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="18" />
                    </Button>
                    <Button Style="{StaticResource LightboxOverlayButton}"
                            Command="{Binding OpenExternalCommand}"
                            ToolTip="Mit Standardprogramm öffnen">
                        <ui:SymbolIcon Symbol="Open24" FontSize="18" />
                    </Button>
                    <Button Style="{StaticResource LightboxOverlayButton}"
                            Command="{Binding ArchiveCurrentCommand}"
                            ToolTip="In die Bibliothek… (Strg+M)">
                        <ui:SymbolIcon Symbol="Archive24" FontSize="18" />
                    </Button>
                    <Button Style="{StaticResource LightboxOverlayButton}"
                            Command="{Binding DeleteCurrentCommand}"
                            ToolTip="In den Papierkorb (Entf)">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="18" />
                    </Button>
                    <Button Style="{StaticResource LightboxOverlayButton}"
                            Command="{Binding ToggleFullscreenCommand}"
                            ToolTip="Vollbild (F11)">
                        <Grid>
                            <ui:SymbolIcon Symbol="FullScreenMaximize24"
                                           FontSize="18"
                                           Visibility="{Binding IsFullscreen, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            <ui:SymbolIcon Symbol="FullScreenMinimize24"
                                           FontSize="18"
                                           Visibility="{Binding IsFullscreen, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status-Hinweis (Favorit gesetzt, Fehler bei Diensten …) -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="16,56,0,0"
                Padding="12,6"
                CornerRadius="6"
                Background="{DynamicResource LightboxChromeBrush}"
                IsHitTestVisible="False"
                Visibility="{Binding StatusText, Converter={StaticResource StringToVis}}">
            <TextBlock Style="{StaticResource LightboxOverlayText}"
                       Text="{Binding StatusText}"
                       MaxWidth="520"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Transportleiste (nur Video) -->
        <Grid VerticalAlignment="Bottom"
              Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
            <Border x:Name="Transport"
                    Padding="12,8"
                    Background="{DynamicResource LightboxChromeBrush}"
                    Visibility="{Binding IsChromeVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource LightboxOverlayButton}"
                            Command="{Binding PlayPauseCommand}"
                            ToolTip="Wiedergabe / Pause (Leertaste)">
                        <Grid>
                            <ui:SymbolIcon Symbol="Play24"
                                           FontSize="20"
                                           Filled="True"
                                           Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            <ui:SymbolIcon Symbol="Pause24"
                                           FontSize="20"
                                           Filled="True"
                                           Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Style="{StaticResource LightboxOverlayText}"
                               Text="{Binding TimeText}"
                               Margin="8,0,4,0"
                               MinWidth="96"
                               FontFamily="Consolas, Segoe UI" />

                    <Slider x:Name="SeekSlider"
                            Grid.Column="2"
                            Style="{StaticResource LightboxSlider}"
                            Margin="12,0"
                            Minimum="0"
                            Maximum="1"
                            SmallChange="0.01"
                            LargeChange="0.05"
                            Value="{Binding PositionFraction, Mode=OneWay}" />

                    <Button Grid.Column="3"
                            Style="{StaticResource LightboxOverlayButton}"
                            Command="{Binding ToggleMuteCommand}"
                            ToolTip="Stumm (M)">
                        <Grid>
                            <ui:SymbolIcon Symbol="Speaker224"
                                           FontSize="18"
                                           Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            <ui:SymbolIcon Symbol="SpeakerMute24"
                                           FontSize="18"
                                           Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>

                    <Slider Grid.Column="4"
                            Style="{StaticResource LightboxSlider}"
                            Width="110"
                            Margin="4,0,0,0"
                            Minimum="0"
                            Maximum="100"
                            SmallChange="5"
                            LargeChange="10"
                            ToolTip="Lautstärke"
                            Value="{Binding Volume, Mode=TwoWay}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
