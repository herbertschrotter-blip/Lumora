<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:shell="clr-namespace:Lumora.Shell"
                    xmlns:local="clr-namespace:Lumora.Folders">
    <!--
        Knoten des Ordnerbaums (Seite „Ordner“). 0.4.30: der gewählte Ordner ist deutlich erkennbar — Akzent-Balken links
        (3 px), Akzent-Tönung als Hintergrund, Ordnersymbol in Akzentfarbe, Name halbfett. Nur DynamicResource (hell/dunkel).
        Balken und Tönung sind „Hidden“ statt „Collapsed“, damit die Zeile beim Wählen nicht springt; Tastatur-Fokus und
        Aufklappen bleiben beim TreeViewItem-Stil (FolderTreePage.xaml).
    -->
    <shell:NullToVisibilityConverter x:Key="FolderNullToVis" />

    <HierarchicalDataTemplate x:Key="FolderNodeTemplate" DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
        <Grid x:Name="Row" ToolTip="{Binding Path}">
            <!-- dezente, gut sichtbare Akzent-Tönung hinter der Zeile -->
            <Border x:Name="SelectionFill"
                    CornerRadius="4"
                    Margin="-2,0,-6,0"
                    Opacity="0.22"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    Visibility="Hidden" />
            <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                <Border x:Name="SelectionBar"
                        Width="3"
                        CornerRadius="1.5"
                        Margin="0,0,5,0"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="Hidden" />
                <ui:SymbolIcon x:Name="FolderIcon"
                               Symbol="Folder16"
                               FontSize="14"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="FolderName" Text="{Binding Name}" VerticalAlignment="Center" />
                <!-- Rolle der Wurzel (ADR-0020) -->
                <Border Margin="6,0,0,0" Padding="5,0" CornerRadius="8" VerticalAlignment="Center"
                        Background="{DynamicResource AccentFillColorTertiaryBrush}"
                        Visibility="{Binding RoleLabel, Converter={StaticResource FolderNullToVis}}">
                    <TextBlock Text="{Binding RoleLabel}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Margin="8,0,0,0"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding FileCount, StringFormat=N0}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IncludeSubfolders, RelativeSource={RelativeSource AncestorType={x:Type local:FolderTreePage}}}" Value="True">
                                    <Setter Property="Text" Value="{Binding TotalFileCount, StringFormat=N0}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
        <HierarchicalDataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="SelectionFill" Property="Visibility" Value="Visible" />
                <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
                <Setter TargetName="FolderIcon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <Setter TargetName="FolderName" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="FolderName" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </DataTrigger>
        </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>
</ResourceDictionary>
