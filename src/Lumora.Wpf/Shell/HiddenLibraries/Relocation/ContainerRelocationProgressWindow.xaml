<dialogs:AppFluentWindow x:Class="Lumora.Shell.HiddenLibraries.Relocation.ContainerRelocationProgressWindow"
                 xmlns:dialogs="clr-namespace:Lumora.Shell.Dialogs"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Container verschieben"
                 Width="600"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 AutomationProperties.AutomationId="ContainerRelocationProgressWindow">

    <!-- Container verschieben, Schritt 4 (Mockup 26: „Läuft“, „Fertig“, „Abgebrochen“). Entsteht erst nach dem Schließen der
         versteckten Sitzung; Abbrechen wirkt beim Kopieren und Prüfen. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Lumora" ShowMaximize="False" ShowMinimize="False" ShowClose="False" />

        <StackPanel Grid.Row="1" Margin="24,0,24,0">
            <TextBlock x:Name="Heading" Text="Container verschieben" FontSize="20" FontWeight="SemiBold" />
            <StackPanel x:Name="Steps" Margin="0,12,0,0" />
            <ProgressBar x:Name="Bar" Margin="30,6,0,4" Height="8" Maximum="1" Visibility="Collapsed" />
            <TextBlock x:Name="Numbers" Margin="30,0,0,0" FontSize="12" Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="RelocationNumbers" />
            <Border x:Name="MessageBorder" Margin="0,14,0,0" Padding="12,10" CornerRadius="6" Visibility="Collapsed">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" LineHeight="19" AutomationProperties.AutomationId="RelocationMessage" />
            </Border>
            <TextBlock x:Name="RunningHint" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Lumora bleibt währenddessen offen, aber ohne versteckte Bibliothek. Abbrechen geht beim Kopieren und Prüfen: die halbe Kopie wird gelöscht, der Container am alten Ort wieder geöffnet." />
        </StackPanel>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="24,12,24,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="CancelButton" Content="Abbrechen" Click="OnCancel" AutomationProperties.Name="Verschieben abbrechen" />
                <ui:Button x:Name="CloseButton" Appearance="Primary" Content="Schließen" Click="OnClose" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</dialogs:AppFluentWindow>
