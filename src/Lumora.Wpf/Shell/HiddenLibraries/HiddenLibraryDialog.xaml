<dialogs:AppFluentWindow x:Class="Lumora.Shell.HiddenLibraries.HiddenLibraryDialog"
                 xmlns:dialogs="clr-namespace:Lumora.Shell.Dialogs"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="520"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 KeyDown="OnKeyDown">

    <!-- Dialoge der versteckten Bibliotheken (ADR-0049): Anlegen, Öffnen (Kennwort, ggf. zurücksetzen), Container öffnen.
         Eigenes Fenster wie AppDialogWindow (keine Wpf.Ui MessageBox); Kennwörter nur in PasswordBoxen. -->
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar" Grid.Row="0" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,20">
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" FontSize="14" />

            <!-- Anlegen -->
            <StackPanel x:Name="CreatePanel" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Label}" Text="Laufwerk (eingehängter Container)" />
                <ComboBox x:Name="DriveBox" AutomationProperties.Name="Laufwerk" />
                <TextBlock Style="{StaticResource Label}" Text="Ordner auf dem Laufwerk (leer = ganzes Laufwerk)" />
                <ui:TextBox x:Name="FolderBox" PlaceholderText="z. B. Fotos" AutomationProperties.Name="Ordner auf dem Laufwerk" />
                <TextBlock Style="{StaticResource Label}" Text="Name der Bibliothek" />
                <ui:TextBox x:Name="NameBox" AutomationProperties.Name="Name der Bibliothek" />
                <TextBlock Style="{StaticResource Label}" Text="Lumora-Kennwort" />
                <PasswordBox x:Name="NewPasswordBox" AutomationProperties.Name="Lumora-Kennwort" />
                <TextBlock Style="{StaticResource Label}" Text="Kennwort wiederholen" />
                <PasswordBox x:Name="RepeatPasswordBox" AutomationProperties.Name="Kennwort wiederholen" />
                <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="6"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" FontWeight="SemiBold" Text="Bitte beachten" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="• Den verschlüsselten Container (VeraCrypt-Datei bzw. BitLocker-VHDX) nie in OneDrive oder einem anderen Cloud-Ordner ablegen." />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                   Text="• „_hidden“ nicht in eine sichtbare Verknüpfung legen — z. B. eine Verknüpfung im Container selbst oder „cmd“ benutzen (nicht Win+R, nicht PowerShell: Windows merkt sich die Eingabe)." />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                   Text="• Lumora verschlüsselt selbst nichts: Katalog, Vorschaubilder und Protokolle liegen im Ordner „.lumora“ in der Bibliothek, also im Container. Lumora merkt sich den Ort nicht." />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                   Text="• Kennwort vergessen: im eingehängten Container die Datei „.lumora\reset-password.txt“ anlegen, dann bietet „Öffnen“ ein neues Kennwort an." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Öffnen -->
            <StackPanel x:Name="UnlockPanel" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Label}" Text="Lumora-Kennwort" />
                <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="Lumora-Kennwort" />
                <CheckBox x:Name="ResetCheck" Margin="0,12,0,0" Visibility="Collapsed"
                          Content="Kennwort zurücksetzen (Bestätigungsdatei im Container gefunden)"
                          Checked="OnResetToggled" Unchecked="OnResetToggled" />
                <StackPanel x:Name="ResetPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Label}" Text="Neues Kennwort" />
                    <PasswordBox x:Name="ResetPasswordBox" AutomationProperties.Name="Neues Kennwort" />
                    <TextBlock Style="{StaticResource Label}" Text="Neues Kennwort wiederholen" />
                    <PasswordBox x:Name="ResetRepeatBox" AutomationProperties.Name="Neues Kennwort wiederholen" />
                </StackPanel>
            </StackPanel>

            <!-- Container öffnen: VeraCrypt-Datei (mit Laufwerksbuchstabe) oder BitLocker-VHDX (Windows wählt den Buchstaben, 0.5.4) -->
            <StackPanel x:Name="MountPanel" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Label}" Text="Containerdatei (BitLocker-VHDX oder VeraCrypt)" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="ContainerFileBox" AutomationProperties.Name="Containerdatei" TextChanged="OnContainerFileChanged" />
                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Durchsuchen…" Click="OnBrowseContainer" />
                </Grid>
                <StackPanel x:Name="LetterPanel">
                    <TextBlock Style="{StaticResource Label}" Text="Laufwerksbuchstabe" />
                    <ComboBox x:Name="LetterBox" Width="90" HorizontalAlignment="Left" AutomationProperties.Name="Laufwerksbuchstabe" />
                </StackPanel>
                <TextBlock x:Name="MountHint" Style="{StaticResource Hint}" Margin="0,12,0,0" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </StackPanel>

        <Border Grid.Row="2" Padding="24,12"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:ProgressRing x:Name="Busy" Width="20" Height="20" Margin="0,0,12,0" IsIndeterminate="True" Visibility="Collapsed" />
                <ui:Button x:Name="PrimaryButton" MinWidth="110" Margin="0,0,8,0" Appearance="Primary" Click="OnPrimaryClick" />
                <ui:Button x:Name="CancelButton" MinWidth="110" Content="Abbrechen" Click="OnCancelClick" />
            </StackPanel>
        </Border>
    </Grid>
</dialogs:AppFluentWindow>
