<UserControl x:Class="Lumora.Places.PlacesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shell="clr-namespace:Lumora.Shell"
             xmlns:map="clr-namespace:Lumora.Places.Map"
             xmlns:vm="clr-namespace:Lumora.Places.ViewModels"
             xmlns:gallery="clr-namespace:Lumora.Gallery.Controls"
             xmlns:pctl="clr-namespace:Lumora.Persons.Controls"
             xmlns:sugg="clr-namespace:Lumora.Places.Suggestions"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PlacesViewModel}"
             d:DesignWidth="1100"
             d:DesignHeight="760">
    <!-- Seite „Orte“ (ADR-0051): Kopfzeile wie die Galerie (Titel, Trefferzeile, Ortssuche), Karte mit Foto-Gruppen
         (eigene Kachelkarte MapControl, OSM-Kacheln, Zuordnung unten rechts) und Seitenleiste „Ohne Ort“ (TileListBox mit
         Blatt-Peers + VirtualizingTilePanel; Ziehen auf die Karte verortet). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Ungenaue Orte (ADR-0062, Mockup 10): Plaketten, Zeilen, Umschalter, Legende -->
                <ResourceDictionary Source="Suggestions/PlacesSuggestionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <shell:BoolToVisibilityConverter x:Key="BoolToVis" />
        <shell:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <shell:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Kartenknöpfe (Zoom, Bereich, Welt, Stil): flach in einer halbtransparenten Leiste (0.5.2, Herberts Wunsch —
             einzeln auf der Karte waren sie im dunklen Design kaum zu sehen) -->
        <Style x:Key="MapButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- Halbtransparente Leiste über der Karte; der Hintergrund ist eine eigene Ebene, damit die Knöpfe deckend bleiben -->
        <Style x:Key="MapBarBackground" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Opacity" Value="0.82" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style x:Key="TileContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnTileMouseDown" />
            <EventSetter Event="PreviewMouseMove" Handler="OnTileMouseMove" />
            <EventSetter Event="KeyDown" Handler="OnTileKeyDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" Margin="3" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ListStyle" TargetType="pctl:TileListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>

        <DataTemplate x:Key="UnlocatedTileTemplate" DataType="{x:Type vm:UnlocatedTile}">
            <Grid ToolTip="{Binding Name}" Background="Transparent" Cursor="Hand">
                <ui:SymbolIcon Symbol="Image24" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <Image Source="{Binding Image}" Stretch="UniformToFill"
                       Visibility="{Binding Image, Converter={StaticResource NullToVis}}" />
                <Border x:Name="Check" Width="20" Height="20" CornerRadius="10" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed">
                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="12" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,12,24,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile: Titel + Trefferzeile links, Galerie-Suche (gemeinsamer Filter) und Ortssuche rechts (Mockup 06) -->
        <gallery:ToolbarFlowPanel Grid.Row="0" Margin="0,0,0,12" Spacing="12">
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <ui:TextBlock FontTypography="Title" Text="Orte" />
                <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run AutomationProperties.AutomationId="PlacesResultLine" Text="{Binding SummaryText, Mode=OneWay}" />
                    <!-- Ungenaue Orte (ADR-0062): „· 158 mit geschätzter Position“ in Warnfarbe -->
                    <Run Text="{Binding EstimatedText, Mode=OneWay, StringFormat=' · {0}'}" FontWeight="SemiBold"
                         Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                </TextBlock>
            </StackPanel>
            <!-- Abstandhalter: schiebt die Suchfelder nach rechts -->
            <Border gallery:ToolbarFlowPanel.Fill="True" MinWidth="0" Height="1" />
            <!-- Suche der Galerie (ADR-0055): dasselbe Steuerelement, derselbe Filter wie Galerie und Ordner -->
            <gallery:GallerySearchBox x:Name="GallerySearch" Width="300" VerticalAlignment="Center" />
            <Grid Width="260" VerticalAlignment="Center">
                <ui:TextBox x:Name="SearchBox"
                            PlaceholderText="Ort suchen …"
                            Icon="{ui:SymbolIcon Search24}"
                            AutomationProperties.Name="Ort suchen"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="OnSearchKeyDown" />
                <Popup x:Name="SearchPopup"
                       PlacementTarget="{Binding ElementName=SearchBox}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       IsOpen="{Binding IsSearchOpen, Mode=TwoWay}">
                    <Border Width="300" Margin="0,4,0,0" Padding="4" CornerRadius="8" BorderThickness="1"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <ListBox x:Name="SearchList" ItemsSource="{Binding SearchResults}" BorderThickness="0" Background="Transparent"
                                 MaxHeight="320" PreviewMouseLeftButtonUp="OnSearchResultClick" KeyDown="OnSearchListKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PlaceSearchResult}">
                                    <StackPanel Margin="4,2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>
        </gallery:ToolbarFlowPanel>

        <!-- Filterkarte der Galerie (ADR-0055): DIESELBE Karte, DERSELBE Filter wie Galerie und Ordner (DataContext =
             GalleryViewModel, im Code-Behind gesetzt). Gruppen, Zähler, „Im Ausschnitt“ und „Ohne Ort“ zeigen nur Treffer. -->
        <gallery:GalleryFilterCard x:Name="FilterCard" Grid.Row="1" Margin="0,0,0,12" ShowHitCount="False" />

        <!-- Hinweise: versteckte Bibliothek (Kacheln aus dem Internet), Ergebnis/Fehler -->
        <StackPanel Grid.Row="2">
            <Border Margin="0,0,0,8" Padding="12,8" CornerRadius="6"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    AutomationProperties.Name="Hinweis Kartenkacheln"
                    Visibility="{Binding IsHiddenNotice, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Globe24" Margin="0,0,8,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="Kartenkacheln werden aus dem Internet geladen (der Kartenserver sieht den betrachteten Ausschnitt)." />
                </StackPanel>
            </Border>
            <Border Margin="0,0,0,8" Padding="12,8" CornerRadius="6"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Padding="6,2" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Schließen"
                               AutomationProperties.Name="Meldung schließen" Command="{Binding DismissMessageCommand}" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="{Binding SidePanelWidth}" />
            </Grid.ColumnDefinitions>

            <!-- ===== Karte ===== -->
            <Border Grid.Column="0" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid ClipToBounds="True">
                    <map:MapControl x:Name="Map"
                                    AutomationProperties.Name="Karte"
                                    AutomationProperties.AutomationId="PlacesMap"
                                    Viewport="{Binding Viewport}"
                                    Markers="{Binding MapMarkers}"
                                    Overlay="{Binding MapOverlay}"
                                    TrackBrush="{StaticResource PlacesTrackBrush}"
                                    StoredBrush="{StaticResource PlacesStoredBrush}"
                                    ExactBrush="{DynamicResource SystemFillColorSuccessBrush}"
                                    Tiles="{Binding Tiles}"
                                    MapBackground="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                    GridBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    AccentBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    BadgeForeground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                    PlaceholderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />

                    <!-- Kartenknöpfe oben rechts in einer halbtransparenten Leiste -->
                    <Grid Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Border Style="{StaticResource MapBarBackground}" />
                        <StackPanel Margin="3">
                            <ui:Button Style="{StaticResource MapButton}" Icon="{ui:SymbolIcon ZoomIn24}" ToolTip="Hineinzoomen (+)"
                                       AutomationProperties.Name="Hineinzoomen" Command="{Binding ZoomInCommand}" />
                            <ui:Button Style="{StaticResource MapButton}" Icon="{ui:SymbolIcon ZoomOut24}" ToolTip="Hinauszoomen (−)"
                                       AutomationProperties.Name="Hinauszoomen" Command="{Binding ZoomOutCommand}" />
                            <ui:Button Style="{StaticResource MapButton}" Icon="{ui:SymbolIcon Image24}" ToolTip="Bereich aller verorteten Fotos"
                                       AutomationProperties.Name="Alle Fotos zeigen" Command="{Binding ShowAllPhotosCommand}" />
                            <ui:Button Style="{StaticResource MapButton}" Icon="{ui:SymbolIcon Globe24}" ToolTip="Ganze Welt"
                                       AutomationProperties.Name="Ganze Welt" Command="{Binding ShowWorldCommand}" />
                            <!-- Kartenstil (ADR-0055): Menü mit allen Stilen, gespeichert wie in Einstellungen › Darstellung -->
                            <ui:Button x:Name="MapStyleButton" Style="{StaticResource MapButton}" Icon="{ui:SymbolIcon Layer24}"
                                       ToolTip="{Binding MapStyleLabel, StringFormat='Kartenstil: {0}'}"
                                       AutomationProperties.AutomationId="PlacesMapStyle"
                                       AutomationProperties.Name="Kartenstil wählen"
                                       Click="OnMapStyleClick" />
                        </StackPanel>
                    </Grid>

                    <!-- Rückfall auf OSM, weil der Schlüssel fehlt (ADR-0055) -->
                    <Border Margin="10,0,10,34" Padding="10,6" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            AutomationProperties.AutomationId="PlacesStyleNotice"
                            Visibility="{Binding HasStyleNotice, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Key24" Margin="0,0,8,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" MaxWidth="520">
                                <Run Text="{Binding MapStyleLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding StyleNotice, Mode=OneWay}" /><Run Text=" (Einstellungen › Darstellung › Karte). Bis dahin OpenStreetMap." />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Ausschnitt in der Galerie zeigen (oben links), dieselbe Leiste wie rechts -->
                    <Grid Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Border Style="{StaticResource MapBarBackground}" />
                        <ui:Button Margin="3" Appearance="Transparent" BorderThickness="0"
                                   Icon="{ui:SymbolIcon ImageMultiple24}"
                                   Content="{Binding VisibleText}"
                                   ToolTip="Alle Fotos im sichtbaren Ausschnitt in der Galerie zeigen"
                                   AutomationProperties.Name="Ausschnitt in der Galerie zeigen"
                                   Command="{Binding ShowVisibleInGalleryCommand}" />
                    </Grid>

                    <!-- Leerzustand -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20,14" CornerRadius="8" MaxWidth="420"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            IsHitTestVisible="False"
                            Visibility="{Binding HasNoLocatedPhotos, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Noch keine verorteten Fotos" FontWeight="SemiBold" FontSize="15" TextAlignment="Center" />
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Fotos rechts unter „Ohne Ort“ auswählen und auf die Karte ziehen — oder Rechtsklick auf die Karte › „Hier verorten“." />
                        </StackPanel>
                    </Border>

                    <ui:ProgressRing HorizontalAlignment="Center" VerticalAlignment="Center" IsIndeterminate="True" Width="36" Height="36"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                    <!-- Zustand der Kachelquelle unten links -->
                    <Border Margin="8" Padding="8,3" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" Opacity="0.92"
                            AutomationProperties.AutomationId="PlacesTileStatus"
                            Visibility="{Binding HasTileStatus, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding TileStatusText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>

                    <!-- Ungenaue Orte (ADR-0062): Legende unten links, Hinweis mit „Rückgängig“ unten in der Mitte -->
                    <sugg:SuggestionMapLegend HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,30"
                                              Visibility="{Binding IsSuggestionMode, Converter={StaticResource BoolToVis}}" />
                    <Border Style="{StaticResource SuggestionToast}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30"
                            AutomationProperties.AutomationId="PlacesSuggestionToast"
                            Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Checkmark24" Margin="0,0,8,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="{Binding ToastText}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                            <ui:Button Content="Rückgängig" Appearance="Transparent" Margin="12,0,0,0" Padding="8,2"
                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       AutomationProperties.Name="Rückgängig" Command="{Binding UndoToastCommand}" />
                            <ui:Button Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent" Padding="4" Margin="2,0,0,0"
                                       ToolTip="Schließen" AutomationProperties.Name="Hinweis schließen" Command="{Binding DismissToastCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Namensnennung des Stils (OSM, CARTO, MapTiler) unten rechts, immer gut sichtbar (ADR-0051/0055) -->
                    <Border Padding="6,2" CornerRadius="4,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" Opacity="0.92">
                        <TextBlock FontSize="11" AutomationProperties.AutomationId="PlacesAttribution">
                            <Hyperlink NavigateUri="{Binding AttributionLink, Mode=OneWay}" RequestNavigate="OnAttributionNavigate"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{Binding Attribution, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== Seitenleiste „Ohne Ort | Ungenau“ ===== -->
            <Border Grid.Column="2" CornerRadius="8" BorderThickness="1" Padding="10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
              <DockPanel>
                <!-- Umschalter (ADR-0062, Mockup 10): „Ohne Ort n | Ungenau m“ -->
                <Border DockPanel.Dock="Top" Style="{StaticResource SuggestionSegment}" Margin="0,0,0,10"
                        HorizontalAlignment="Left"
                        Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SuggestionSegmentButton}" GroupName="PlacesSide"
                                     AutomationProperties.AutomationId="PlacesModeUnlocated"
                                     AutomationProperties.Name="Ohne Ort"
                                     Content="{Binding UnlocatedButtonText}"
                                     IsChecked="{Binding IsUnlocatedMode, Mode=OneWay}"
                                     Command="{Binding ShowUnlocatedModeCommand}" />
                        <RadioButton Style="{StaticResource SuggestionSegmentButton}" GroupName="PlacesSide"
                                     AutomationProperties.AutomationId="PlacesModeInaccurate"
                                     AutomationProperties.Name="Ungenau"
                                     Content="{Binding InaccurateButtonText}"
                                     IsChecked="{Binding IsInaccurateMode, Mode=OneWay}"
                                     Command="{Binding ShowInaccurateModeCommand}" />
                    </StackPanel>
                </Border>
                <!-- „Ohne Ort“: Kacheln zum Ziehen (ADR-0051) -->
                <DockPanel Visibility="{Binding IsUnlocatedMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel DockPanel.Dock="Top" Margin="2,0,2,8">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Padding="8,3" Content="Auswahl aufheben" FontSize="12"
                                       Command="{Binding ClearSelectionCommand}"
                                       Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding UnlocatedHeader}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="PlacesUnlocatedHeader" />
                        </DockPanel>
                        <TextBlock Margin="0,4,0,0" Text="{Binding SelectionText}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <!-- Fotos ohne Ort mit Vorschlag (ADR-0062) -->
                        <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                AutomationProperties.AutomationId="PlacesUnlocatedHint"
                                Visibility="{Binding HasUnlocatedHint, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,3" FontSize="12"
                                           Content="Vorschläge zeigen" AutomationProperties.Name="Vorschläge für Fotos ohne Ort zeigen"
                                           Command="{Binding ShowUnlocatedSuggestionsCommand}" />
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info16" Margin="0,1,6,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding UnlocatedHint}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    <Grid>
                        <TextBlock Text="Alle Fotos sind verortet." FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding HasUnlocated, Converter={StaticResource InverseBoolToVis}}" />
                        <pctl:TileListBox x:Name="UnlocatedList"
                                          AutomationProperties.Name="Fotos ohne Ort"
                                          ItemsSource="{Binding Unlocated}"
                                          ItemTemplate="{StaticResource UnlocatedTileTemplate}"
                                          ItemContainerStyle="{StaticResource TileContainer}"
                                          Style="{StaticResource ListStyle}"
                                          gallery:VirtualizingTilePanel.VisibleRangeChanged="OnUnlocatedVisibleRangeChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <gallery:VirtualizingTilePanel ItemWidth="92" ItemHeight="92" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </pctl:TileListBox>
                    </Grid>
                </DockPanel>
                <!-- „Ungenau“ bzw. „Ohne Ort“ mit Vorschlag (ADR-0062) -->
                <sugg:SuggestionPanel Visibility="{Binding IsSuggestionMode, Converter={StaticResource BoolToVis}}" />
              </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
