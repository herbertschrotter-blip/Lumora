<UserControl x:Class="Lumora.Places.Suggestions.SuggestionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shell="clr-namespace:Lumora.Shell"
             xmlns:local="clr-namespace:Lumora.Places.Suggestions"
             xmlns:vm="clr-namespace:Lumora.Places.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PlacesViewModel}"
             d:DesignWidth="400" d:DesignHeight="700">
    <!-- Seitenleiste „Ungenau“ bzw. „Ohne Ort“ mit Vorschlag (ADR-0062, Mockup 10): Erklärung mit Zählern, Filter-Chips,
         Liste nach Tagen/Ausflügen (virtualisiert), Speichern „nur im Katalog“ / „auch ins Foto schreiben (EXIF)“,
         „Garmin + sichere übernehmen“ und „Ausflug“. DataContext = PlacesViewModel (geerbt). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PlacesSuggestionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <shell:BoolToVisibilityConverter x:Key="BoolToVis" />
            <shell:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <shell:NullToVisibilityConverter x:Key="NullToVis" />

            <Style x:Key="RowButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="2,0,0,0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="RowContainer" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnRowMouseDown" />
                <EventSetter Event="KeyDown" Handler="OnRowKeyDown" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate DataType="{x:Type local:SuggestionGroupRow}">
                <Border Padding="4,10,4,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Übernehmen" FontSize="12" Padding="10,3" VerticalAlignment="Center"
                                   ToolTip="Alle Vorschläge dieses Tages übernehmen"
                                   AutomationProperties.Name="Ausflug übernehmen"
                                   Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}"
                                   Command="{Binding DataContext.ApplyGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                   CommandParameter="{Binding}" />
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="CalendarLtr16" Margin="0,2,8,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </DataTemplate>

            <!-- Eine Quelle im Vergleich (Mockup 25): Punkt in der Farbe der Karte, Text, Abstand, Knopf -->
            <DataTemplate x:Key="SourceTemplate" DataType="{x:Type local:SuggestionSourceRow}">
                <Border x:Name="Src" Padding="6,5" CornerRadius="6" Background="Transparent" Cursor="Hand"
                        AutomationProperties.Name="{Binding AutomationName}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DataContext.HighlightSourceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                      CommandParameter="{Binding}" />
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="86" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="Dot" Width="12" Height="12" VerticalAlignment="Top" Margin="0,3,0,0" HorizontalAlignment="Left"
                                 Stroke="White" StrokeThickness="2" Fill="{StaticResource PlacesStoredBrush}" />
                        <StackPanel Grid.Column="1" Margin="2,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Name" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                <!-- eigene Plakette: der Stil SuggestionBadge bindet BadgeKind der Foto-Zeile -->
                                <Border CornerRadius="8" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsChosen, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="Vorschlag" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Line}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding DetailText}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="Km" Grid.Column="2" Text="{Binding DistanceText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <ui:Button Content="Behalten" FontSize="12" Padding="10,3" ToolTip="Gespeicherte Position behalten (= Ablehnen)"
                                       AutomationProperties.Name="Position laut Foto behalten"
                                       Visibility="{Binding CanKeep, Converter={StaticResource BoolToVis}}"
                                       Command="{Binding DataContext.RejectRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       CommandParameter="{Binding Owner}" />
                            <ui:Button Content="Nehmen" FontSize="12" Padding="10,3" ToolTip="Diese Quelle als Vorschlag nehmen"
                                       AutomationProperties.Name="{Binding Title, StringFormat='{}{0} nehmen'}"
                                       Visibility="{Binding CanTake, Converter={StaticResource BoolToVis}}"
                                       Command="{Binding DataContext.ChooseSourceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       CommandParameter="{Binding}" />
                            <ui:Button Appearance="Primary" Content="Übernehmen" FontSize="12" Padding="10,3"
                                       AutomationProperties.Name="Vorschlag übernehmen"
                                       Visibility="{Binding IsChosen, Converter={StaticResource BoolToVis}}"
                                       Command="{Binding DataContext.ApplyRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       CommandParameter="{Binding Owner}" />
                        </Grid>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Track">
                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource PlacesTrackBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Time">
                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource PlacesTimeBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsChosen}" Value="True">
                        <Setter TargetName="Src" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                        <Setter TargetName="Dot" Property="Fill" Value="Transparent" />
                        <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Setter TargetName="Dot" Property="StrokeDashArray" Value="2 1" />
                        <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Setter TargetName="Km" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate DataType="{x:Type local:SuggestionItemRow}">
                <StackPanel>
                <Border x:Name="Row" Padding="4,6" CornerRadius="4" Background="Transparent" Cursor="Hand"
                        AutomationProperties.Name="{Binding AutomationName}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="4" ClipToBounds="True"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <ui:SymbolIcon Symbol="Image24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Image Source="{Binding Image}" Stretch="UniformToFill"
                                       Visibility="{Binding Image, Converter={StaticResource NullToVis}}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                <Border Style="{StaticResource SuggestionBadge}">
                                    <TextBlock Text="{Binding BadgeText}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                       ToolTip="{Binding SourceText}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Übernommen: Rückgängig -->
                            <ui:Button Style="{StaticResource RowButton}" Icon="{ui:SymbolIcon ArrowUndo16}" ToolTip="Rückgängig"
                                       AutomationProperties.Name="Rückgängig"
                                       Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}"
                                       Command="{Binding DataContext.UndoRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       CommandParameter="{Binding}" />
                            <!-- Mit Vorschlag: übernehmen / ablehnen -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}">
                                <ui:Button Style="{StaticResource RowButton}" Icon="{ui:SymbolIcon Checkmark16}" ToolTip="Übernehmen"
                                           AutomationProperties.Name="Vorschlag übernehmen"
                                           Command="{Binding DataContext.ApplyRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Style="{StaticResource RowButton}" Icon="{ui:SymbolIcon Dismiss16}" ToolTip="Ablehnen (bleibt, wie es ist)"
                                           AutomationProperties.Name="Vorschlag ablehnen"
                                           Command="{Binding DataContext.RejectRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           CommandParameter="{Binding}" />
                            </StackPanel>
                            <!-- Ohne Vorschlag: Ort setzen -->
                            <ui:Button x:Name="SetPlace" Style="{StaticResource RowButton}" Icon="{ui:SymbolIcon Location16}" ToolTip="Ort setzen…"
                                       AutomationProperties.Name="Ort setzen" Visibility="Collapsed"
                                       Command="{Binding DataContext.SetPlaceForRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Quellen nebeneinander, nur unter der ausgewählten, offenen Zeile (Mockup 25) -->
                <Border x:Name="Compare" Margin="4,2,4,10" Padding="8,8,8,6" CornerRadius="8" BorderThickness="1" Visibility="Collapsed"
                        AutomationProperties.AutomationId="PlacesSourceCompare"
                        AutomationProperties.Name="Quellen für dieses Foto"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <DockPanel Margin="6,0,6,4">
                            <TextBlock DockPanel.Dock="Right" Text="Abstand zum Foto-Punkt" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="QUELLEN FÜR DIESES FOTO" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource SourceTemplate}" Focusable="False" />
                        <Border x:Name="Verdict" Margin="0,6,0,0" Padding="9,7" CornerRadius="6"
                                Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}">
                            <DockPanel>
                                <ui:SymbolIcon x:Name="VerdictIcon" DockPanel.Dock="Left" Symbol="Checkmark16" FontSize="13" Margin="0,1,8,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="{Binding Verdict}" FontSize="12" TextWrapping="Wrap" LineHeight="17"
                                           AutomationProperties.AutomationId="PlacesSourceVerdict" />
                            </DockPanel>
                        </Border>
                        <TextBlock Margin="6,5,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Zeile anklicken zeigt den Punkt auf der Karte · Tasten 1 2 3 wählen die Quelle" />
                    </StackPanel>
                </Border>
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        <Setter TargetName="Row" Property="BorderThickness" Value="3,0,0,0" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected}" Value="True" />
                            <Condition Binding="{Binding IsApplied}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="Compare" Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding VerdictKind}" Value="Warn">
                        <Setter TargetName="Verdict" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                        <Setter TargetName="VerdictIcon" Property="Symbol" Value="Warning16" />
                        <Setter TargetName="VerdictIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding VerdictKind}" Value="Info">
                        <Setter TargetName="Verdict" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Setter TargetName="VerdictIcon" Property="Symbol" Value="Info16" />
                        <Setter TargetName="VerdictIcon" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding HasSuggestion}" Value="False" />
                            <Condition Binding="{Binding IsApplied}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="SetPlace" Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <!-- Kopf: zurück (nur „Ohne Ort“ mit Vorschlag), Erklärung, Filter -->
        <StackPanel DockPanel.Dock="Top" Margin="2,0,2,8">
            <ui:Button HorizontalAlignment="Left" Padding="8,3" FontSize="12" Margin="0,0,0,6"
                       Icon="{ui:SymbolIcon ArrowLeft16}" Content="Alle Fotos ohne Ort"
                       AutomationProperties.Name="Zurück zu allen Fotos ohne Ort"
                       Visibility="{Binding IsInaccurateMode, Converter={StaticResource InverseBoolToVis}}"
                       Command="{Binding ShowUnlocatedModeCommand}" />
            <TextBlock Text="{Binding SuggestionSummary}" TextWrapping="Wrap" FontSize="12" LineHeight="18"
                       AutomationProperties.AutomationId="PlacesSuggestionSummary"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding FilterChips}" AutomationProperties.Name="Filter der Vorschläge">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:SuggestionFilterChip}">
                        <Button Style="{StaticResource SuggestionChip}" Content="{Binding Text}"
                                AutomationProperties.Name="{Binding Label}"
                                Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Visibility="{Binding HasNoActivities, Converter={StaticResource BoolToVis}}"
                       Text="Noch keine GPS-Spuren — in Einstellungen › Orte den Garmin-Datenexport bzw. FIT/GPX-Dateien einlesen." />
        </StackPanel>

        <!-- Fuß: Speichern + Übernehmen -->
        <Border DockPanel.Dock="Bottom" Margin="-10,8,-10,-10" Padding="12,10,12,12" CornerRadius="0,0,8,8" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Speichern:" FontSize="12" Margin="0,0,10,4" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <RadioButton GroupName="SuggestionSave" Content="nur im Katalog" FontSize="12" Margin="0,0,12,4" MinWidth="0"
                                 AutomationProperties.AutomationId="PlacesSaveCatalog"
                                 IsChecked="{Binding SaveToCatalogOnly}" />
                    <RadioButton GroupName="SuggestionSave" Content="auch ins Foto schreiben (EXIF)" FontSize="12" Margin="0,0,0,4" MinWidth="0"
                                 AutomationProperties.AutomationId="PlacesSaveFile"
                                 ToolTip="JPEG: GPS ins EXIF (verlustfrei, rückgängig machbar); RAW/HEIC/PNG/WebP: XMP-Begleitdatei; Videos: nur Katalog."
                                 IsChecked="{Binding SaveToFile}" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Checkmark16}" Content="{Binding ApplyTrackAndSureText}"
                               AutomationProperties.AutomationId="PlacesApplyTrackAndSure"
                               AutomationProperties.Name="Garmin und sichere übernehmen"
                               Command="{Binding ApplyTrackAndSureCommand}" />
                    <ui:Button Margin="8,0,0,0" Content="{Binding ApplyGroupText}"
                               ToolTip="Alle Vorschläge des Tages der ausgewählten Zeile übernehmen"
                               AutomationProperties.Name="Ausflug übernehmen"
                               Command="{Binding ApplyGroupCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid>
            <TextBlock FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding HasSuggestionRows, Converter={StaticResource InverseBoolToVis}}"
                       Text="{Binding EmptySuggestionText}" />
            <ListBox x:Name="Rows"
                     AutomationProperties.Name="Fotos mit Vorschlag"
                     AutomationProperties.AutomationId="PlacesSuggestionList"
                     ItemsSource="{Binding SuggestionRows}"
                     ItemContainerStyle="{StaticResource RowContainer}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" />
        </Grid>
    </DockPanel>
</UserControl>
