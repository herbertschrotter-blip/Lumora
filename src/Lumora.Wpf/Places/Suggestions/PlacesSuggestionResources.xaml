<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ungenaue Orte (ADR-0062, Mockup 10): Farben der Karte und Plaketten, Umschalter, Filter-Chips, Hinweis.
         Farben ohne Gegenstück in WPF-UI (Spur, gespeicherter Punkt, Garmin-Plakette) sind mittlere Töne, die hell und dunkel
         lesbar sind; alles andere über DynamicResource. -->

    <!-- Spur der Aktivität (Mockup: Markenfarbe Koralle) und gespeicherte, geschätzte Position (grau) -->
    <SolidColorBrush x:Key="PlacesTrackBrush" Color="#F97362" />
    <SolidColorBrush x:Key="PlacesStoredBrush" Color="#9AA0A6" />
    <!-- „laut Zeit“ im Quellen-Vergleich (Mockup 25: Violett der Marke) -->
    <SolidColorBrush x:Key="PlacesTimeBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="PlacesGarminBadgeBackground" Color="#29F97362" />
    <SolidColorBrush x:Key="PlacesGarminBadgeForeground" Color="#E0533F" />

    <!-- Umschalter „Ohne Ort | Ungenau“ (Segment) -->
    <Style x:Key="SuggestionSegment" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="2" />
    </Style>
    <Style x:Key="SuggestionSegmentButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="4" Padding="11,5" Background="Transparent" Margin="0,0,2,0">
                        <ContentPresenter x:Name="Text" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                            <Setter TargetName="Text" Property="TextElement.Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <Setter TargetName="Text" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                            <Setter TargetName="Bg" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter-Chip -->
    <Style x:Key="SuggestionChip" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chip" Height="26" Padding="10,0" Margin="0,0,6,6" CornerRadius="13" BorderThickness="1"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <ContentPresenter x:Name="Text" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Text" Property="TextElement.Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <Setter TargetName="Text" Property="TextElement.FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plakette „Garmin-Spur / sicher / wahrscheinlich / kein Vorschlag / übernommen“ -->
    <Style x:Key="SuggestionBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextElement.FontSize" Value="10" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding BadgeKind}" Value="garmin">
                <Setter Property="Background" Value="{StaticResource PlacesGarminBadgeBackground}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource PlacesGarminBadgeForeground}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding BadgeKind}" Value="sure">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding BadgeKind}" Value="likely">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding BadgeKind}" Value="done">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Hinweis mit „Rückgängig“ über der Karte -->
    <Style x:Key="SuggestionToast" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
</ResourceDictionary>
