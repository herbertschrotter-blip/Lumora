<dialogs:AppFluentWindow xmlns:dialogs="clr-namespace:Lumora.Shell.Dialogs"
        x:Class="Lumora.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:shell="clr-namespace:Lumora.Shell"
                 xmlns:settings="clr-namespace:Lumora.Settings"
                 xmlns:gallery="clr-namespace:Lumora.Gallery.Views"
                 xmlns:sorter="clr-namespace:Lumora.Sorter"
                 xmlns:persons="clr-namespace:Lumora.Persons"
                 xmlns:places="clr-namespace:Lumora.Places"
                 xmlns:duplicates="clr-namespace:Lumora.Duplicates"
                 xmlns:albums="clr-namespace:Lumora.Albums"
                 xmlns:branding="clr-namespace:Lumora.Shell.Branding"
                 xmlns:stories="clr-namespace:Lumora.Stories"
                 Title="{x:Static branding:LumoraBrand.ProductName}"
                 Height="800"
                 Width="1280"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">

    <!-- Zähler „n neu“ an „Storys“ (ADR-0060) -->
    <dialogs:AppFluentWindow.Resources>
        <shell:BoolToVisibilityConverter x:Key="StoriesBadgeVis" />
    </dialogs:AppFluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Titelleiste „Lumora“ mit App-Symbol (ADR-0047; unter 32 px die vereinfachte Variante) -->
        <ui:TitleBar Grid.Row="0" Title="{x:Static branding:LumoraBrand.ProductName}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{x:Static branding:LumoraIconImages.Small}" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Seiten werden über TargetPageType + INavigationViewPageProvider (DI, gecacht) aufgelöst;
             SelectionChanged feuert damit zuverlässig (WPF-UI navigiert nur bei gesetztem TargetPageType).
             Leiste seit 0.2.44 (ADR-0042): oben der Bibliotheks-Umschalter, dann die Arbeitsseiten; Bibliothek, Tags und
             Kategorien sind Reiter der Einstellungen (NavigationTags.Library/Tags/Categories öffnen dorthin). -->
        <ui:NavigationView x:Name="MainNav"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="220"
                           IsBackButtonVisible="Collapsed">

            <ui:NavigationView.PaneHeader>
                <shell:LibrarySwitcher DataContext="{Binding LibrarySwitcher}" />
            </ui:NavigationView.PaneHeader>

            <ui:NavigationView.MenuItems>
                <!-- Galerie mit Ordnerleiste (ADR-0068, Mockup 18) — der Punkt „Ordner“ entfällt -->
                <ui:NavigationViewItem Content="Galerie"
                                       TargetPageTag="gallery"
                                       TargetPageType="{x:Type gallery:GalleryPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Image24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <!-- Alben: Fotos verknüpfen statt kopieren (ADR-0054) -->
                <ui:NavigationViewItem Content="Alben"
                                       TargetPageTag="albums"
                                       TargetPageType="{x:Type albums:AlbumsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Album24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <!-- Storys: Ereignisse, Reisen, Rückblicke, Personen, Orte mit Zähler „n neu“ (ADR-0060) -->
                <ui:NavigationViewItem Content="Storys"
                                       TargetPageTag="stories"
                                       TargetPageType="{x:Type stories:StoriesPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="BookOpen24" />
                    </ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.InfoBadge>
                        <ui:InfoBadge Severity="Informational"
                                      Value="{Binding Text, Source={x:Static stories:StoriesNavigationBadge.Shared}}"
                                      Visibility="{Binding HasNew, Source={x:Static stories:StoriesNavigationBadge.Shared}, Converter={StaticResource StoriesBadgeVis}}"
                                      AutomationProperties.AutomationId="StoriesNewBadge" />
                    </ui:NavigationViewItem.InfoBadge>
                </ui:NavigationViewItem>
                <!-- Personen (Gesichtserkennung, ADR-0037) -->
                <ui:NavigationViewItem Content="Personen"
                                       TargetPageTag="persons"
                                       TargetPageType="{x:Type persons:PersonsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="People24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <!-- Orte: Weltkarte mit Foto-Gruppen (ADR-0051) -->
                <ui:NavigationViewItem Content="Orte"
                                       TargetPageTag="places"
                                       TargetPageType="{x:Type places:PlacesPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Map24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <!-- Doppelte: gleiche und ähnliche Fotos finden und aufräumen (ADR-0053) -->
                <ui:NavigationViewItem Content="Doppelte"
                                       TargetPageTag="duplicates"
                                       TargetPageType="{x:Type duplicates:DuplicatesPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DocumentCopy24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Sortieren"
                                       TargetPageTag="sorter"
                                       TargetPageType="{x:Type sorter:SorterPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="FolderArrowRight24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Einstellungen"
                                       TargetPageTag="settings"
                                       TargetPageType="{x:Type settings:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- Statusleiste (ADR-0013): Scan · Vorschaubilder · Hintergrund · Hinweise -->
        <shell:StatusBar Grid.Row="2" DataContext="{Binding StatusBar}" />
    </Grid>
</dialogs:AppFluentWindow>
