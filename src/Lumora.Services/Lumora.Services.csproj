<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumora.Domain\Lumora.Domain.csproj" />
    <ProjectReference Include="..\Lumora.Data\Lumora.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
    <!-- Container-Assistent (ADR-0061, Nachtrag 0.4.26): Storage-Verwaltung von Windows (WMI root\Microsoft\Windows\Storage)
         für Initialisieren/Partition/Formatieren der neuen VHDX im erhöhten Lumora-Lauf -->
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <!-- Strukturgrößen der virtdisk-P/Invokes prüfen (VirtualDiskNative, ADR-0061 Nachtrag 0.4.26) -->
    <InternalsVisibleTo Include="Lumora.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ortsnamen offline (ADR-0050): GeoNames cities5000, verdichtet von build/geonames/Build-GeoNames.ps1 (CC BY 4.0). -->
    <EmbeddedResource Include="Places\Data\geonames.tsv.gz" LogicalName="Lumora.Services.Places.geonames.tsv.gz" />
  </ItemGroup>

</Project>
