<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core + SQLite -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.0" />

    <!-- Storage-Profile-Detection (Spike #6); seit 0.4.26 auch Services: VHDX-Datenträger einrichten (ADR-0061, Nachtrag) -->
    <PackageVersion Include="System.Management" Version="9.0.0" />

    <!-- App-Verbindung (ADR-0073): Geheimnis der Kopplung mit Windows-DPAPI (Benutzerbereich) -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />

    <!-- Transitive Security-Pins (NU1902/NU1903), greifen dank CentralPackageTransitivePinningEnabled=true:
         System.Security.Cryptography.Xml/Pkcs (GHSA-37gx-xxp4-5rgx u. a. in 9.0.0, GHSA-23rf-6693-g89p u. a. in 10.0.7)
         und SQLitePCLRaw 2.1.11 (GHSA-2m69-gcr7-jv3q). Stand 2026-10-19: jeweils neueste 10.0.x bzw. 2.1.x. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="2.1.14" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.14" />

    <!-- Hosting + DI + Logging -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />

    <!-- MVVM -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- WPF-UI Theme -->
    <PackageVersion Include="WPF-UI" Version="4.0.2" />

    <!-- Video (Spike #3 — Cutline ab V0.1 falls rot) -->
    <PackageVersion Include="LibVLCSharp.WPF" Version="3.9.3" />
    <PackageVersion Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />

    <!-- Archive (ZIP/RAR/7z/TAR/GZ/BZ2/XZ) — PLAN Kap. 10, ADR-0022; nur im Services-Projekt -->
    <PackageVersion Include="SharpCompress" Version="0.50.6" />

    <!-- Gesichtserkennung (ADR-0035): ONNX Runtime mit DirectML (Grafikkarte, Rückfall CPU); nur im Services-Projekt -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />

    <!-- Logging via Serilog -->
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />

    <!-- Tests -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
